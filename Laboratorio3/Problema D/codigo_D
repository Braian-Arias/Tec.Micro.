 // RETARDO CON UART
//______________________________________________________

// durante toda la canción, se revisa UART cada 10 ms.

static uint8_t esperar_duracion(uint16_t milisegundos)
{
    uint16_t tiempo;
    uint16_t pasos;

    pasos = milisegundos / 10;

    for (tiempo = 0; tiempo < pasos; tiempo++) {

        _delay_ms(10);

        if (uart_hay_dato()) {

            char comando;

            comando = uart_recibir_caracter();

            if (comando == 'S' ||
                comando == 's' ||
                comando == 'P' ||
                comando == 'p') {

                detener_sonido();

                modo_actual = MODO_PIANO;

                lcd_limpiar();

                lcd_posicion(0, 0);
                lcd_texto("MODO PIANO");

                lcd_posicion(1, 0);
                lcd_texto("Esperando...");

                uart_enviar_texto(
                    "\r\nCancion detenida.\r\n"
                );

                return 0;
            }
        }
    }

    return 1;
}

