
% PROBLEMA B - GRAFICAS EN TIEMPO REAL
% ATmega328P - UART 9600 baudios

clear;
clc;
close all;

% Cambiar COM3 por el puerto correspondiente
puerto = "COM10";
baudrate = 9600;

s = serialport(puerto, baudrate);
configureTerminator(s, "LF");
flush(s);

% Vectores para almacenar datos
tiempo = [];
setpoint = [];
ldr = [];
posicion = [];
pwm = [];
sentido = [];

% Crear ventana
figure('Name', 'Problema B - Control de iluminacion');

while ishandle(gcf)

    linea = strtrim(readline(s));
    datos = split(linea, ",");

    if numel(datos) ~= 6
        continue;
    end

    valores = str2double(datos(1:5));

    if any(isnan(valores))
        continue;
    end

    estado = strtrim(datos(6));

    if estado == "ABRIENDO"
        giro = 1;
    elseif estado == "CERRANDO"
        giro = -1;
    else
        giro = 0;
    end

    tiempo(end+1) = valores(1) / 1000;
    setpoint(end+1) = valores(2);
    ldr(end+1) = valores(3);
    posicion(end+1) = valores(4);
    pwm(end+1) = valores(5);
    sentido(end+1) = giro;

    % Grafica 1
    subplot(4,1,1);
    plot(tiempo, setpoint, '--', ...
         tiempo, ldr, '-');
    ylabel('ADC');
    title('Setpoint e iluminacion');
    legend('Setpoint', 'LDR');
    ylim([0 1023]);
    grid on;

    % Grafica 2
    subplot(4,1,2);
    plot(tiempo, posicion);
    ylabel('Posicion ADC');
    title('Posicion de la persiana');
    ylim([0 1023]);
    grid on;

    % Grafica 3
    subplot(4,1,3);
    plot(tiempo, pwm);
    ylabel('PWM');
    title('Velocidad del motor');
    ylim([0 255]);
    grid on;

    % Grafica 4
    subplot(4,1,4);
    stairs(tiempo, sentido);
    ylabel('Sentido');
    xlabel('Tiempo (s)');
    title('Sentido de giro');
    yticks([-1 0 1]);
    yticklabels({'Cerrar','Detenido','Abrir'});
    ylim([-1.5 1.5]);
    grid on;

    drawnow limitrate;

end

clear s;
