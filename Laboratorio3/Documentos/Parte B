const int LDR = A0;
const int POT = A1;

const int IN1 = 4;
const int IN2 = 5;
const int ENA = 6;

int iluminacion = 0;
int posicion = 0;

setpoint fijo
int setpoint = 500;

// Margen para evitar movimientos constantes
int tolerancia = 30;


void setup() {

  Serial.begin(9600);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);

  // Motor detenido al iniciar
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, 0);

  Serial.println("Sistema iniciado");
}
void loop() {
  // Lectura de sensores
  iluminacion = analogRead(LDR);
  posicion = analogRead(POT);

  // Mostrar datos
  Serial.print("Setpoint: ");
  Serial.print(setpoint);

  Serial.print(" | Luz: ");
  Serial.print(iluminacion);

  Serial.print(" | Posicion: ");
  Serial.print(posicion);

  // ------------------------------
  // CONTROL
  // ------------------------------

  if (iluminacion < setpoint - tolerancia) {

    // Falta luz -> abrir persiana

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);

    analogWrite(ENA, 180);

    Serial.println(" | Motor: ABRIENDO");
  }

  else if (iluminacion > setpoint + tolerancia) {

    // Hay demasiada luz -> cerrar persiana

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);

    analogWrite(ENA, 180);

    Serial.println(" | Motor: CERRANDO");
  }

  else {

    // Iluminacion cercana al setpoint

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);

    analogWrite(ENA, 0);

    Serial.println(" | Motor: DETENIDO");
  }

  delay(500);
}
