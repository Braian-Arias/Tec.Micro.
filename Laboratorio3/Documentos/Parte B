#ifndef F_CPU
#define F_CPU 16000000UL
#endif

#include <avr/io.h>
#include <stdint.h>
#include <stdlib.h>

// ==========================================
// CONFIGURACION
// ==========================================

#define IN1 PD4
#define IN2 PD5
#define ENA PD6

#define TOLERANCIA 30
#define LIMITE_CERRADO 50
#define LIMITE_ABIERTO 970

#define PWM_MINIMO 90

#define BAUD 9600UL
#define UBRR_VAL ((F_CPU / (16UL * BAUD)) - 1)

// Variables
uint16_t iluminacion = 0;
uint16_t posicion = 0;

// SETPOINT INICIAL = 150
uint16_t setpoint = 150;
int16_t error = 0;
uint8_t pwm = 0;
const char *estado = "DETENIDO";
char entrada[12];
uint8_t indice = 0;
uint8_t entradaInvalida = 0;
// ==========================================
// ADC
// ==========================================
void ADC_Init(void)
{
    ADMUX = (1 << REFS0);

    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}
uint16_t ADC_Read(uint8_t canal)
{
    ADMUX = (1 << REFS0) | (canal & 0x07);
    ADCSRA |= (1 << ADSC);
    while (ADCSRA & (1 << ADSC));
    return ADC;
}
// ==========================================
// MOTOR Y PWM
// ==========================================
void Motor_Init(void)
{
    DDRD |= (1 << IN1) |
            (1 << IN2) |
            (1 << ENA);
    PORTD &= ~((1 << IN1) | (1 << IN2));
    // Timer0 Fast PWM
    TCCR0A = (1 << COM0A1) |
             (1 << WGM01) |
             (1 << WGM00);
    TCCR0B = (1 << CS01) |
             (1 << CS00);
    OCR0A = 0;
}
void Motor_Detener(void)
{
    OCR0A = 0;
    PORTD &= ~((1 << IN1) | (1 << IN2));
    pwm = 0;
    estado = "DETENIDO";
}
void Motor_Abrir(uint8_t velocidad)
{
    PORTD |= (1 << IN1);
    PORTD &= ~(1 << IN2);
    OCR0A = velocidad;
    pwm = velocidad;
    estado = "ABRIENDO";
}
void Motor_Cerrar(uint8_t velocidad)
{
    PORTD &= ~(1 << IN1);
    PORTD |= (1 << IN2);
    OCR0A = velocidad;
    pwm = velocidad;
    estado = "CERRANDO";
}
// ==========================================
// UART
// ==========================================
void UART_Init(void)
{
    UBRR0H = (uint8_t)(UBRR_VAL >> 8);
    UBRR0L = (uint8_t)UBRR_VAL;
    UCSR0A = 0;
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}
void UART_EnviarChar(char dato)
{
    while (!(UCSR0A & (1 << UDRE0)));
    UDR0 = dato;
}
void UART_EnviarTexto(const char *texto)
{
    while (*texto)
    {
        UART_EnviarChar(*texto++);
    }
}
void UART_EnviarNumero(uint32_t numero)
{
    char buffer[12];
    ultoa(numero, buffer, 10);
    UART_EnviarTexto(buffer);
}
// ==========================================
// RECIBIR SETPOINT
// ==========================================
void UART_RecibirSetpoint(void)
{
    while (UCSR0A & (1 << RXC0))
    {
        char c = UDR0;
        if (c == '\n' || c == '\r')
        {
            if (indice > 0 || entradaInvalida)
            {
                if (!entradaInvalida && indice > 0)
                {
                    entrada[indice] = '\0';
                    unsigned long nuevo =
                        strtoul(entrada, 0, 10);
                    if (nuevo <= 1023)
                    {
                        setpoint = (uint16_t)nuevo;
                    }
                }
                indice = 0;
                entradaInvalida = 0;
            }
        }
        else if (c >= '0' && c <= '9')
        {
            if (indice < sizeof(entrada) - 1)
            {
                entrada[indice++] = c;
            }
            else
            {
                entradaInvalida = 1;
            }
        }
        else
        {
            entradaInvalida = 1;
        }
    }
}
// ==========================================
// CONTROL DE ILUMINACION
// ==========================================
void Control_Iluminacion(void)
{
    error = (int16_t)setpoint -
            (int16_t)iluminacion;
    int16_t diferencia = abs(error);
    if (diferencia <= TOLERANCIA)
    {
        Motor_Detener();
        return;
    }

    // PWM proporcional Kp = 1.5
    uint16_t calculoPWM =
        ((uint16_t)diferencia * 3) / 2;
    if (calculoPWM > 255)
        calculoPWM = 255;
    if (calculoPWM < PWM_MINIMO)
        calculoPWM = PWM_MINIMO;
    pwm = (uint8_t)calculoPWM;
    if (error > 0)
    {
        // Falta luz: abrir
        if (posicion < LIMITE_ABIERTO)
        {
            Motor_Abrir(pwm);
        }
        else
        {
            Motor_Detener();
            estado = "LIMITE_ABIERTO";
        }
    }
    else
    {
        // Sobra luz: cerrar
        if (posicion > LIMITE_CERRADO)
        {
            Motor_Cerrar(pwm);
        }
        else
        {
            Motor_Detener();
            estado = "LIMITE_CERRADO";
        }
    }
}
// ==========================================
// ENVIAR DATOS CSV
// ==========================================
void Enviar_Datos(uint32_t tiempo)
{
    UART_EnviarNumero(tiempo);
    UART_EnviarChar(',');
    UART_EnviarNumero(setpoint);
    UART_EnviarChar(',');
    UART_EnviarNumero(iluminacion);
    UART_EnviarChar(',');
    UART_EnviarNumero(posicion);
    UART_EnviarChar(',');
    UART_EnviarNumero(pwm);
    UART_EnviarChar(',');
    UART_EnviarTexto(estado);
    UART_EnviarTexto("\r\n");
}
// ==========================================
// MAIN
// ==========================================
int main(void)
{
    ADC_Init();
    Motor_Init();
    UART_Init();
    Motor_Detener();
    UART_EnviarTexto(
        "Sistema de control de iluminacion\r\n"
    );

    UART_EnviarTexto(
        "Setpoint inicial: 150\r\n"
    );

    UART_EnviarTexto(
        "Tiempo,Setpoint,LDR,Posicion,PWM,Estado\r\n"
    );
    // Timer1: base de tiempo de 1 ms
    TCCR1A = 0;
    TCCR1B = (1 << WGM12) |
             (1 << CS11) |
             (1 << CS10);
    OCR1A = 249;
    TCNT1 = 0;
    TIFR1 = (1 << OCF1A);
    uint32_t tiempo = 0;
    uint16_t contador = 0;
    while (1)
    {
        UART_RecibirSetpoint();
        if (TIFR1 & (1 << OCF1A))
        {
            TIFR1 = (1 << OCF1A);
            tiempo++;
            contador++;
            if (contador >= 500)
            {
                contador = 0;
                iluminacion = ADC_Read(0);
                posicion = ADC_Read(1);
                Control_Iluminacion();
                Enviar_Datos(tiempo);
            }
        }
    }

    return 0;
}
