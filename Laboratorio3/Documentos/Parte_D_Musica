 // REPRODUCIR CANCION
//______________________________________________________
static void reproducir_cancion(uint8_t numero)
{
    const nota_cancion_t *melodia;
    const uint8_t *bajo;

    uint8_t posicion;
    uint8_t nota_melodia;
    uint8_t nota_bajo;

    uint16_t duracion;

    melodia = obtener_cancion(numero);
    bajo = obtener_bajo(numero);

    posicion = 0;

    mostrar_cancion_lcd(numero);

    while (melodia[posicion].nota != 0) {

        /*
         * Revisar UART antes de cada nota.
         */
        if (uart_hay_dato()) {

            char comando;

            comando = uart_recibir_caracter();

            if (comando == 'S' ||
                comando == 's' ||
                comando == 'P' ||
                comando == 'p') {

                detener_sonido();

                modo_actual = MODO_PIANO;

                lcd_limpiar();

                lcd_posicion(0, 0);
                lcd_texto("MODO PIANO");

                lcd_posicion(1, 0);
                lcd_texto("Esperando...");

                uart_enviar_texto(
                    "\r\nVolviendo a piano.\r\n"
                );

                return;
            }
        }

        nota_melodia =
            melodia[posicion].nota;

        /*
         * El bajo se repite.
         */
        nota_bajo =
            bajo[posicion % 8];

        /*
         * Activar ambos buzzers.
         */
        buzzer_melodia_frecuencia(
            frecuencias_notas[nota_melodia]
        );

        buzzer_bajo_frecuencia(
            frecuencias_notas[nota_bajo]
        );

        /*
         * Mostrar nota actual.
         */
        lcd_limpiar_linea(0);

        lcd_posicion(0, 0);

        lcd_texto("C");

        lcd_numero(numero);

        lcd_texto(" ");

        lcd_texto(
            nombres_notas[nota_melodia]
        );

        lcd_limpiar_linea(1);

        lcd_posicion(1, 0);

        lcd_texto("Melodia+Bajo");

        /*
         * Duración:
         *
         * 1 = 250 ms
         * 2 = 500 ms
         * 3 = 750 ms
         * 4 = 1000 ms
         */
        duracion =
            (uint16_t)
            melodia[posicion].duracion * 250U;

        /*
         * Esperar y permitir STOP.
         */
        if (!esperar_duracion(duracion)) {
            return;
        }

        posicion++;
    }

    /*
     * Fin de canción.
     */
    detener_sonido();

    lcd_limpiar();

    lcd_posicion(0, 0);

    lcd_texto("Cancion ");

    lcd_numero(numero);

    lcd_posicion(1, 0);

    lcd_texto("Finalizada");

    uart_enviar_texto(
        "\r\nCancion finalizada.\r\n"
    );

    _delay_ms(1000);

    modo_actual = MODO_PIANO;

    lcd_limpiar();

    lcd_posicion(0, 0);

    lcd_texto("MODO PIANO");

    lcd_posicion(1, 0);

    lcd_texto("Esperando...");
}

 // PROCESAMIENTO UART
//______________________________________________________
static void procesar_uart(void)
{
    char comando;

    if (!uart_hay_dato()) {
        return;
    }

    comando = uart_recibir_caracter();

    /*
     * C = seleccionar canción.
     *
     * Se espera un segundo carácter:
     *
     * C1
     * C2
     * C3
     */
    if (comando == 'C' ||
        comando == 'c') {

        /*
         * Esperar segundo carácter.
         */
        while (!uart_hay_dato()) {
            /* Esperar */
        }

        comando = uart_recibir_caracter();

        if (comando == '1') {

            cancion_actual = 1;

            modo_actual = MODO_CANCION;

            uart_enviar_texto(
                "\r\nSeleccionada Cancion 1\r\n"
            );
        }

        else if (comando == '2') {

            cancion_actual = 2;

            modo_actual = MODO_CANCION;

            uart_enviar_texto(
                "\r\nSeleccionada Cancion 2\r\n"
            );
        }

        else if (comando == '3') {

            cancion_actual = 3;

            modo_actual = MODO_CANCION;

            uart_enviar_texto(
                "\r\nSeleccionada Cancion 3\r\n"
            );
        }

        else {

            uart_enviar_texto(
                "\r\nComando incorrecto.\r\n"
            );
        }
    }

    /*
     * S = detener
     */
    else if (comando == 'S' ||
             comando == 's') {

        modo_actual = MODO_PIANO;

        detener_sonido();

        lcd_limpiar();

        lcd_posicion(0, 0);

        lcd_texto("MODO PIANO");

        lcd_posicion(1, 0);

        lcd_texto("Esperando...");

        uart_enviar_texto(
            "\r\nCancion detenida.\r\n"
        );
    }

    /*
     * P = piano
     */
    else if (comando == 'P' ||
             comando == 'p') {

        modo_actual = MODO_PIANO;

        detener_sonido();

        lcd_limpiar();

        lcd_posicion(0, 0);

        lcd_texto("MODO PIANO");

        lcd_posicion(1, 0);

        lcd_texto("Esperando...");

        uart_enviar_texto(
            "\r\nModo piano.\r\n"
        );
    }

    /*
     * M = mostrar menu
     */
    else if (comando == 'M' ||
             comando == 'm') {

        uart_enviar_texto(
            "\r\n--- PIANO ELECTRONICO ---\r\n"
        );

        uart_enviar_texto(
            "C1 - Cancion 1\r\n"
        );

        uart_enviar_texto(
            "C2 - Cancion 2\r\n"
        );

        uart_enviar_texto(
            "C3 - Cancion 3\r\n"
        );

        uart_enviar_texto(
            "S  - Detener\r\n"
        );

        uart_enviar_texto(
            "P  - Modo piano\r\n"
        );
    }
}

 // MODO PIANO
//______________________________________________________
static void modo_piano(void)
{
    uint8_t boton;

    boton = leer_boton();

    if (boton != 0) {

        /*
         * Reproducir nota.
         */
        reproducir_nota(boton);

        /*
         * Mostrar en LCD.
         */
        mostrar_nota_lcd(boton);

        /*
         * Mostrar por UART.
         */
        uart_enviar_texto(
            "Nota: "
        );

        uart_enviar_texto(
            nombres_notas[boton]
        );

        uart_enviar_texto(
            " - "
        );

        uart_enviar_texto(
            "Frecuencia: "
        );

        /*
         * Convertir frecuencia a texto.
         */
        {
            char texto[6];

            utoa(
                frecuencias_notas[boton],
                texto,
                10
            );

            uart_enviar_texto(texto);
        }

        uart_enviar_texto(" Hz\r\n");

        /*
         * Esperar hasta soltar el botón.
         */
        while (leer_boton() != 0) {

            /*
             * Si llega un comando UART,
             * atenderlo.
             */
            if (uart_hay_dato()) {
                procesar_uart();

                if (modo_actual != MODO_PIANO) {
                    return;
                }
            }
        }

        /*
         * Detener sonido al soltar botón.
         */
        detener_sonido();

        lcd_limpiar_linea(0);

        lcd_posicion(0, 0);

        lcd_texto("MODO PIANO");

        lcd_limpiar_linea(1);

        lcd_posicion(1, 0);

        lcd_texto("Esperando...");
    }
}

