 //I2C
//______________________________________________________
static void i2c_iniciar(void)
{
    TWSR = 0;
    TWBR = 72;       // Aproximadamente 100 kHz 
    TWCR = (1 << TWEN);
}

static uint8_t i2c_esperar(void)
{
    uint16_t intentos = 60000;

    while (!(TWCR & (1 << TWINT)) && intentos > 0) {
        intentos--;
    }

    return intentos > 0;
}

static uint8_t i2c_enviar_byte(uint8_t direccion, uint8_t dato)
{
    /* START */
    TWCR = (1 << TWINT) | (1 << TWSTA) | (1 << TWEN);

    if (!i2c_esperar()) {
        return 0;
    }

    /* Dirección + escritura */
    TWDR = (uint8_t)(direccion << 1);

    TWCR = (1 << TWINT) | (1 << TWEN);

    if (!i2c_esperar()) {
        return 0;
    }

    if ((TWSR & 0xF8) != 0x18) {
        TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWSTO);
        return 0;
    }

    /* Dato */
    TWDR = dato;

    TWCR = (1 << TWINT) | (1 << TWEN);

    if (!i2c_esperar()) {
        return 0;
    }

    /* STOP */
    TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWSTO);

    return 1;
}


 //LCD
//______________________________________________________
static uint8_t lcd_expansor(uint8_t dato)
{
    return i2c_enviar_byte(
        DIRECCION_LCD,
        (uint8_t)(dato | BIT_LUZ_LCD)
    );
}

static void lcd_pulso_enable(uint8_t dato)
{
    lcd_expansor((uint8_t)(dato | BIT_ENABLE_LCD));

    _delay_us(1);

    lcd_expansor((uint8_t)(dato & ~BIT_ENABLE_LCD));

    _delay_us(50);
}

static void lcd_enviar_nibble(uint8_t nibble, uint8_t modo_dato)
{
    uint8_t salida;

    salida = (uint8_t)((nibble & 0x0F) << 4);

    if (modo_dato) {
        salida |= BIT_RS_LCD;
    }

    lcd_expansor(salida);

    lcd_pulso_enable(salida);
}

static void lcd_enviar_byte(uint8_t dato, uint8_t modo_dato)
{
    if (!lcd_disponible) {
        return;
    }

    lcd_enviar_nibble((uint8_t)(dato >> 4), modo_dato);

    lcd_enviar_nibble((uint8_t)(dato & 0x0F), modo_dato);
}

static void lcd_comando(uint8_t comando)
{
    lcd_enviar_byte(comando, 0);
}

static void lcd_caracter(char caracter)
{
    lcd_enviar_byte((uint8_t)caracter, 1);
}

static void lcd_iniciar(void)
{
    _delay_ms(50);

    lcd_disponible = lcd_expansor(0);

    if (!lcd_disponible) {
        return;
    }

    /* Secuencia inicial */
    lcd_enviar_nibble(0x03, 0);
    _delay_ms(5);
    lcd_enviar_nibble(0x03, 0);
    _delay_us(150);
    lcd_enviar_nibble(0x03, 0);
    _delay_ms(2);
    lcd_enviar_nibble(0x02, 0);
    _delay_ms(2);
    /* LCD 4 bits, 2 líneas */
    lcd_comando(0x28);
    _delay_ms(2);
    /* Display ON, cursor OFF */
    lcd_comando(0x0C);
    _delay_ms(2);
    /* Incrementar posición */
    lcd_comando(0x06);
    _delay_ms(2);
    /* Limpiar pantalla */
    lcd_comando(0x01);
    _delay_ms(2);
}

static void lcd_posicion(uint8_t fila, uint8_t columna)
{
    uint8_t posicion;

    if (fila == 0) {
        posicion = columna;
    } else {
        posicion = (uint8_t)(0x40 + columna);
    }

    lcd_comando((uint8_t)(0x80 | posicion));
}

static void lcd_texto(const char *texto)
{
    while (*texto != '\0') {
        lcd_caracter(*texto);
        texto++;
    }
}

static void lcd_numero(uint16_t numero)
{
    char texto_numero[6];

    utoa(numero, texto_numero, 10);

    lcd_texto(texto_numero);
}

static void lcd_limpiar(void)
{
    lcd_comando(0x01);
    _delay_ms(2);
}

static void lcd_limpiar_linea(uint8_t fila)
{
    uint8_t columna;

    lcd_posicion(fila, 0);

    for (columna = 0; columna < 16; columna++) {
        lcd_caracter(' ');
    }
}

 //UART
//______________________________________________________

static void uart_iniciar(void)
{
    UBRR0H = (uint8_t)(VALOR_UBRR >> 8);
    UBRR0L = (uint8_t)VALOR_UBRR;

    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

static void uart_enviar_caracter(char caracter)
{
    while (!(UCSR0A & (1 << UDRE0))) {
        /* Esperar */
    }

    UDR0 = caracter;
}

static void uart_enviar_texto(const char *texto)
{
    while (*texto != '\0') {
        uart_enviar_caracter(*texto);
        texto++;
    }
}

static uint8_t uart_hay_dato(void)
{
    return (UCSR0A & (1 << RXC0)) != 0;
}

static char uart_recibir_caracter(void)
{
    return UDR0;
}

 //botones
//______________________________________________________
static void botones_iniciar(void)
{
    DDRD &= ~(
        (1 << DDD2) |
        (1 << DDD3) |
        (1 << DDD4) |
        (1 << DDD5) |
        (1 << DDD6) |
        (1 << DDD7)
    );

    PORTD |= (
        (1 << PORTD2) |
        (1 << PORTD3) |
        (1 << PORTD4) |
        (1 << PORTD5) |
        (1 << PORTD6) |
        (1 << PORTD7)
    );

    DDRB &= ~(
        (1 << DDB0) |
        (1 << DDB1)
    );

    PORTB |= (
        (1 << PORTB0) |
        (1 << PORTB1)
    );
}

static uint8_t leer_boton(void)
{
    if (!(PIND & (1 << PIND2))) {
        return 1; //DO
    }

    if (!(PIND & (1 << PIND3))) {
        return 2; //RE
    }

    if (!(PIND & (1 << PIND4))) {
        return 3; //MI
    }

    if (!(PIND & (1 << PIND5))) {
        return 4; //FA
    }

    if (!(PIND & (1 << PIND6))) {
        return 5; //SOL
    }

    if (!(PIND & (1 << PIND7))) {
        return 6; //LA
    }

    if (!(PINB & (1 << PINB0))) {
        return 7; //SI
    }

    if (!(PINB & (1 << PINB1))) {
        return 8; //DO5
    }

    return 0;
}

 // TIMER2 - BUZZER MELODIA
//______________________________________________________

/*
 * Timer2 funciona en CTC.
 *
 * OCR2A se calcula para obtener aproximadamente:
 *
 * f = F_CPU / (2 * prescaler * (OCR2A + 1))
 *
 * Se utiliza prescaler 8.
 */

static void buzzer_melodia_detener(void)
{
    TCCR2A = 0;
    TCCR2B = 0;

    PORTB &= ~(1 << BUZZER_MELODIA_PIN);
}

static void buzzer_melodia_frecuencia(uint16_t frecuencia)
{
    uint32_t valor;

    if (frecuencia == 0) {
        buzzer_melodia_detener();
        return;
    }

    valor =
        ((uint32_t)F_CPU /
        (2UL * 8UL * frecuencia)) - 1UL;

    if (valor > 255UL) {
        valor = 255UL;
    }

    DDRB |= (1 << BUZZER_MELODIA_PIN);

    TCCR2A =
        (1 << COM2A0) |
        (1 << WGM21);

    TCCR2B =
        (1 << CS21);

    OCR2A = (uint8_t)valor;
}

 // TIMER1 - BUZZER BAJO
//______________________________________________________

/*
 * Timer1 genera una interrupción cada medio período.
 *
 * En cada interrupción se cambia manualmente PB5.
 */

static void buzzer_bajo_detener(void)
{
    TCCR1A = 0;
    TCCR1B = 0;

    TIMSK1 = 0;

    PORTB &= ~(1 << BUZZER_BAJO_PIN);

    buzzer_bajo_activo = 0;
}

static void buzzer_bajo_frecuencia(uint16_t frecuencia)
{
    uint32_t valor;

    if (frecuencia == 0) {
        buzzer_bajo_detener();
        return;
    }

    valor =
        ((uint32_t)F_CPU /
        (2UL * 64UL * frecuencia)) - 1UL;

    if (valor > 65535UL) {
        valor = 65535UL;
    }

    DDRB |= (1 << BUZZER_BAJO_PIN);

    TCNT1 = 0;

    OCR1A = (uint16_t)valor;

    TCCR1A = 0;

    TCCR1B =
        (1 << WGM12) |
        (1 << CS11) |
        (1 << CS10);

    TIMSK1 =
        (1 << OCIE1A);

    buzzer_bajo_activo = 1;
}

 // INTERRUPCION TIMER1
//______________________________________________________
ISR(TIMER1_COMPA_vect)
{
    if (buzzer_bajo_activo) {

        PORTB ^= (1 << BUZZER_BAJO_PIN);
    }
}

 // SONIDO
//______________________________________________________
static void sonido_iniciar(void)
{
    DDRB |=
        (1 << BUZZER_MELODIA_PIN) |
        (1 << BUZZER_BAJO_PIN);

    buzzer_melodia_detener();

    buzzer_bajo_detener();

    sei();
}

static void detener_sonido(void)
{
    buzzer_melodia_detener();

    buzzer_bajo_detener();
}

