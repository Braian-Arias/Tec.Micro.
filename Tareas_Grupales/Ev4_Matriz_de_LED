.include "m328pdef.inc"
.def SEQ = r22
.def CAMBIO = r23
.org 0x0000
    rjmp INICIO
.org 0x0008 ;C0-C5
    rjmp RSI_PCINT1

;========================================================
; INICIO
;========================================================
INICIO:
    ; Inicializar pila
    ldi r16, HIGH(RAMEND)
    out SPH, r16
    ldi r16, LOW(RAMEND)
    out SPL, r16

    ;====================================================
    ; MATRIZ
    ; D0-D7 = columnas
    ; B0-B7 = filas
    ;====================================================
    ldi r16, 0xFF
    out DDRD, r16
    out DDRB, r16

    ;====================================================
    ; BOTONES
    ; PC1 = SIGUIENTE
    ; PC2 = ANTERIOR
    ;====================================================
    ldi r16, 0x00
    out DDRC, r16

    ; Pull-up PC1 y PC2
    ldi r16, 0b00000110
    out PORTC, r16
;====================================================
; INTERRUPCIONES PCINT
;====================================================
    ; Habilitar PCINT del PORTC
    ldi r16, 0b00000010
    sts PCICR, r16

    ; PC1 = PCINT9
    ; PC2 = PCINT10
    ldi r16, 0b00000110
    sts PCMSK1, r16

    ; Comenzar en la secuencia 1
    ldi SEQ, 1
    clr CAMBIO

    sei

;========================================================
; MAIN
;========================================================
MAIN:
    clr CAMBIO

    cpi SEQ, 1
    breq SECUENCIA_1

    cpi SEQ, 2
    breq SECUENCIA_2

    cpi SEQ, 2
    breq SECUENCIA_2

    rjmp MAIN

;========================================================
; SECUENCIA 1
; SONRISA / GUINIO
;========================================================
SECUENCIA_1:
    rcall SONRISA_1S
    cpi CAMBIO, 0
    brne MAIN

    rcall GUINIO_1S
    cpi CAMBIO, 0
    brne MAIN

    rjmp SECUENCIA_1

;========================================================
; SECUENCIA 2
; CORAZÓN / :3
;========================================================
SECUENCIA_2:
    rcall CORAZON_1S
    cpi CAMBIO, 0
    brne MAIN

    rcall CARA3_1S
    cpi CAMBIO, 0
    brne MAIN

    rjmp SECUENCIA_2

;========================================================
; SECUENCIA 3
; ASTERISCO / XD
;========================================================
SECUENCIA_3:
    rcall ASTERISCO_1S
    cpi CAMBIO, 0
    brne MAIN

    rcall XD_1S
    cpi CAMBIO, 0
    brne MAIN

    rjmp SECUENCIA_3

;========================================================
; INTERRUPCIÓN DE LOS BOTONES
;========================================================
RSI_PCINT1:
    push r16
    in r16, SREG
    push r16

    in r16, PINC
    andi r16, 0b00000110

    ; PC1 = SIGUIENTE
    ; PC1 presionado -> PC2 queda en 1
    ; valor = 00000100
    cpi r16, 0b00000100
    breq SIGUIENTE

    ; PC2 = ANTERIOR
    ; PC2 presionado -> PC1 queda en 1
    ; valor = 00000010
    cpi r16, 0b00000010
    breq ANTERIOR

    rjmp FINAL

;========================================================
; BOTÓN SIGUIENTE PC1
;========================================================
SIGUIENTE:
    inc SEQ
    cpi SEQ, 4
    brne CAMBIO_PANTALLA
    ldi SEQ, 1

CAMBIO_PANTALLA:
    ldi CAMBIO, 1
    rjmp FINAL

;========================================================
; BOTÓN ANTERIOR PC2
;========================================================
ANTERIOR:
    dec SEQ
    cpi SEQ, 0
    brne CAMBIO_PANTALLA
    ldi SEQ, 3

FINAL:
    pop r16
    out SREG, r16
    pop r16
    reti

;========================================================
; SONRISA 1 SEGUNDO
;========================================================
SONRISA_1S:
    ldi r20, 130

SONRISA_LOOP:
    rcall cara_sonrisa

    cpi CAMBIO, 0
    brne FIN_SONRISA

    dec r20
    brne SONRISA_LOOP

FIN_SONRISA:
    ret

