; - Contador arriba-abajo + dp 
;Generar un Contador arriba-abajo (up-down) con un microcontrolador Atmega328P,
;que muestre los números de forma ascendente y descendente, 
;adicional a esto, el punto del display debe parpadear cada segundo sin importar si se activa el contador.

; 2/9 3:16
; Cierre: viernes, 4 de septiembre de 2026, 05:00
.include "m328pdef.inc"

.org 0x0000
    rjmp Inicio
;0x0016 TIMER1_COMPA Timer/Counter1 Compare Match A  (datashit pag74)
.org 0x0016
    rjmp TIMER1_COMPA
;----------------------------------------------------
;ATmega328P = 16 MHz
;Prescaler = 1024
;modo CTC
;OCR1A = 15624
;----------------------------------------------------

    ; Modo CTC
    ldi r16, (1<<WGM12)
    sts TCCR1B, r16

    ; Valor de comparación
    ldi r16, high(15624)
    sts OCR1AH, r16
    ldi r16, low(15624)
    sts OCR1AL, r16

    ; Habilitar interrupción por comparación A
    ldi r16, (1<<OCIE1A)
    sts TIMSK1, r16

    ; Prescaler = 1024
    ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)
    sts TCCR1B, r16

    ; Habilitar interrupciones globales
    sei
;----------------------------------------------------
Inicio:

    ;----------------------------------------------------
    ; Configurar PORTD como salida led
    ;----------------------------------------------------

    ; Configurar salidas
    ldi r16, 0b11111111   ; PD1..PD7 como salida
    out DDRD, r16
    ;----------------------------------------------------
    ; Configurar PORTC como entrada boton
    ;----------------------------------------------------

    ldi r22, 0x00             ; Puerto C como entrada
    out DDRB, r22

    ; Pull-up interno en PC0, PC1 y PC2
    ldi r22, (1<<PORTB0)|(1<<PORTB1)|(1<<PORTB2)
    out PORTB, r22
	ldi r16, 0
    ;----------------------------------------------------
    ; Configurar contador en cero
    ;----------------------------------------------------
    ldi r17, 0x00
	cero:
	sbic PINB, PB2
	rjmp main_loop
	sbis PINB, PB1
	rjmp B0
	rjmp cero
B0:
ldi r16,0b00111111  ;0
    out PORTD, r16
	ldi r17, 0
	sbis PINB, PB0 ; CONTINUAMENTE SE FIJA SI SE TIENE QUE REINICIAR
    rjmp main_loop 
	rjmp B0
main_loop:
    mov r19, r17

    sbis PINB, PB0
    rjmp menu_1
    sbis PINB, PB1     
    rjmp menu_2
	rcall delay
	rcall delay
    sbis PINB, PB2
	rjmp cero
    rjmp main_loop

