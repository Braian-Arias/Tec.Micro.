;========================================================
; DELAY de aproximadamente 1 segundo
;========================================================
	Delay:
    ldi  r27, 234
    ldi  r28, 200
    ldi  r29, 199
L1: dec  r29
    breq L1
    dec  r28
    breq L1
    dec  r27
    breq L1
    ret 
;========================================================
; interupcion automatica de aproximadamente 1 segundo
;========================================================
TIMER1_COMPA:
    in r16, PORTD     ; Leer nuemro actual de PORTD (led)
    ldi r18, (1<<PD7)     ; Máscara para PD7 r18 = 10000000
    eor r16, r18     ; como no se uso PD7 siempre es 0 entonces la suma siemre cambia a 1 para PD7
;y sumar cero deja el numero igual (eor=XOR/OR)
    out PORTD, r16     ; Escribir nuevamente PORTD 
    reti     ; Regresar al programa principal de la interrupcion

