;_________________________________________
; Inicializar UART 9600 8N1
uart_init:
  ldi r16,HIGH(103)
  sts UBRR0H,r16
  ldi r16,LOW(103)
  sts UBRR0L,r16
  ldi r16,(1<<UCSZ01)|(1<<UCSZ00)
  sts UCSR0C,r16
  ldi r16,(1<<RXEN0)|(1<<TXEN0)
  sts UCSR0B,r16
  ret

;_________________________________________________________________________________________________
; Transmitir carácter por UART
uart_tx:
  uart_tx_wait:
    lds r17,UCSR0A
    sbrs r17,UDRE0
    rjmp uart_tx_wait
  sts UDR0,r16
  ret

;_________________________________________________________________________________________________
; Recibir carácter por UART
uart_rx:
  uart_rx_wait:
    lds r17,UCSR0A
    sbrs r17,RXC0
    rjmp uart_rx_wait
  lds r16,UDR0
  ret

;_________________________________________________________________________________________________
; Transmitir string desde memoria de programa (terminado en 0)
; Z = puntero
uart_print:
  lpm r16,Z+
  cpi r16,0
  breq uart_print_end
  rcall uart_tx
  rjmp uart_print
uart_print_end:
  ret
