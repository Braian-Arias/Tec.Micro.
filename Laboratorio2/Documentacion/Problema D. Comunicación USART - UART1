.include "m328Pdef.inc"

.cseg
.org 0x0000
    rjmp INICIO


INICIO:

    ; Stack
    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ldi r16, LOW(RAMEND)
    out SPL, r16


    ; -----------------------------------
    ; PD2, PD3, PD4 entradas
    ; PD1 TX
    ; -----------------------------------

    ldi r16, (1<<PD1)
    out DDRD, r16


    ; Pull-up en los 3 pulsadores
    ldi r16, (1<<PD2)|(1<<PD3)|(1<<PD4)
    out PORTD, r16


    ; -----------------------------------
    ; UART 9600 - 16 MHz
    ; UBRR = 103
    ; -----------------------------------

    ldi r16, 0
    sts UBRR0H, r16

    ldi r16, 103
    sts UBRR0L, r16


    ; Habilitar TX
    ldi r16, (1<<TXEN0)
    sts UCSR0B, r16


    ; 8 bits, sin paridad, 1 stop
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16


    ; Valor anterior
    ldi r19, 0xFF


MAIN:

    ; Leer PIND
    in r16, PIND


    ; Los pulsadores son activos en LOW
    ; Invertimos
    com r16


    ; PD2-PD4 pasan a bits 0-2
    lsr r16
    lsr r16


    ; Solo conservar 3 bits
    andi r16, 0x07


    ; Si no cambió, no enviar
    cp r16, r19
    breq MAIN


    ; Guardar nuevo valor
    mov r19, r16


    ; Esperar UART disponible

ESPERAR_TX:

    lds r17, UCSR0A
    sbrs r17, UDRE0
    rjmp ESPERAR_TX


    ; Enviar 0-7
    sts UDR0, r16


    ; Pequeño retardo antirrebote
    rcall DELAY


    rjmp MAIN


; -----------------------------------
; Retardo
; -----------------------------------

DELAY:

    ldi r20, 100

D1:
    ldi r21, 255

D2:
    dec r21
    brne D2

    dec r20
    brne D1

    ret
