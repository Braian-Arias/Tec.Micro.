.include "m328Pdef.inc"

.equ CERRADA  = 0
.equ ABRIENDO = 1
.equ ABIERTA  = 2
.equ CERRANDO = 3

.cseg
.org 0x0000
    rjmp inicio

inicio:

    ; PB0 y PB1 salidas para el motor
    ldi r16, 0b00000011
    out DDRB, r16

    ; motor apagado al inicio
    clr r16
    out PORTB, r16

    ; PC0 a PC3 entradas
    clr r16
    out DDRC, r16

    ; activar pull-up
    ldi r16, 0b00001111
    out PORTC, r16

    ; PD4, PD5 y PD6 salidas para los leds
    ldi r16, 0b01110000
    out DDRD, r16

    ; al iniciar solo prende el led de detenido
    ldi r16, 0b01000000
    out PORTD, r16

    ; la puerta arranca cerrada
    ldi r18, CERRADA

principal:

    ; revisar el estado
    cpi r18, CERRADA
    breq puerta_cerrada

    cpi r18, ABRIENDO
    breq puerta_abriendo

    cpi r18, ABIERTA
    breq puerta_abierta

    cpi r18, CERRANDO
    breq puerta_cerrando

    rjmp principal

; --------------------------------------------------
; PUERTA CERRADA
; --------------------------------------------------

puerta_cerrada:

    ; PC0 = boton abrir
    sbis PINC, PC0
    rjmp abrir

    rjmp principal

; --------------------------------------------------
; ABRIR
; --------------------------------------------------

abrir:

    ; motor gira para abrir
    sbi PORTB, PB0
    cbi PORTB, PB1

    ; led abriendo prendido
    sbi PORTD, PD4

    ; apagar los otros leds
    cbi PORTD, PD5
    cbi PORTD, PD6

    ldi r18, ABRIENDO

    rjmp principal

; --------------------------------------------------
; ABRIENDO
; --------------------------------------------------

puerta_abriendo:

    ; PC2 = sensor de puerta abierta
    sbis PINC, PC2
    rjmp llego_abierta

    rjmp principal

; --------------------------------------------------
; LLEGO ABIERTA
; --------------------------------------------------

llego_abierta:

    ; detener motor
    cbi PORTB, PB0
    cbi PORTB, PB1

    ; apagar leds de movimiento
    cbi PORTD, PD4
    cbi PORTD, PD5

    ; prender led detenido
    sbi PORTD, PD6

    ldi r18, ABIERTA

    rjmp principal

; --------------------------------------------------
; PUERTA ABIERTA
; --------------------------------------------------

puerta_abierta:

    ; PC1 = boton cerrar
    sbis PINC, PC1
    rjmp cerrar

    rjmp principal

; --------------------------------------------------
; CERRAR
; --------------------------------------------------

cerrar:

    ; motor gira al otro lado
    cbi PORTB, PB0
    sbi PORTB, PB1

    ; led cerrando prendido
    cbi PORTD, PD4
    sbi PORTD, PD5
    cbi PORTD, PD6

    ldi r18, CERRANDO

    rjmp principal

; --------------------------------------------------
; CERRANDO
; --------------------------------------------------

puerta_cerrando:

    ; PC3 = sensor de puerta cerrada
    sbis PINC, PC3
    rjmp llego_cerrada

    rjmp principal

; --------------------------------------------------
; LLEGO CERRADA
; --------------------------------------------------

llego_cerrada:

    ; detener motor
    cbi PORTB, PB0
    cbi PORTB, PB1

    ; apagar leds de movimiento
    cbi PORTD, PD4
    cbi PORTD, PD5

    ; prender led detenido
    sbi PORTD, PD6

    ldi r18, CERRADA

    rjmp principal
