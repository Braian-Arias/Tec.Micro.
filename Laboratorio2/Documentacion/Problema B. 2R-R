;_____________________________________________
; GENERADOR DAC R-2R
; MENU:
;   1 = Senal 8
;   2 = Senal 17
;   + = Aumentar frecuencia
;   - = Disminuir frecuencia
; DAC:
;   PD2 = bit 0
;   PD3 = bit 1
;   PD4 = bit 2
;   PD5 = bit 3
;   PD6 = bit 4
;   PD7 = bit 5
;   PB0 = bit 6
;   PB1 = bit 7
; UART:
;   PD0 = RX
;   PD1 = TX
; ATmega328P
;   F_CPU = 16 MHz
;   UART = 9600
;   Timer1 CTC
;   Prescaler = 64
;_____________________________________________
.include "m328Pdef.inc"
.def temp      = r16
.def dato      = r17
.def aux       = r18
.def seleccion = r19
.def indice    = r20
.equ VEL_INICIAL = 249
.equ VEL_MIN     = 49
.equ VEL_MAX     = 249
.equ PASO_VEL    = 25
.dseg
velocidad:
    .byte 1
.cseg
.org 0x0016
    rjmp TIMER1_ISR
.org 0x0000
    rjmp RESET
;_____________________________________________
RESET:
    ldi temp, HIGH(RAMEND)
    out SPH, temp
    ldi temp, LOW(RAMEND)
    out SPL, temp
    ldi temp, 0b11111110
    out DDRD, temp
    ldi temp, 0b00000011
    out DDRB, temp
    ldi temp, 0
    out PORTB, temp
    in aux, PORTD
    andi aux, 0b00000011
    out PORTD, aux
;_____________________________________________
;UART
    rcall uart_init
    ldi temp, 0
    sts TCCR1A, temp
    ldi temp, (1<<WGM12)|(1<<CS11)|(1<<CS10)
    sts TCCR1B, temp
    ldi temp, HIGH(VEL_INICIAL)
    sts OCR1AH, temp
    ldi temp, LOW(VEL_INICIAL)
    sts OCR1AL, temp
    ldi temp, (1<<OCIE1A)
    sts TIMSK1, temp

    ldi temp, VEL_INICIAL
    sts velocidad, temp
    ldi seleccion, 0
    ldi indice, 0
    ldi ZL, LOW(mensaje_inicio<<1)
    ldi ZH, HIGH(mensaje_inicio<<1)
    rcall uart_print
    rcall mostrar_menu
    sei
;_____________________________________________
MAIN:
    rcall uart_rx
    cpi temp, 13
    breq MAIN
    cpi temp, 10
    breq MAIN
    cpi temp, '1'
    breq CMD_SENAL8
    cpi temp, '2'
    breq CMD_SENAL17
    cpi temp, '+'
    breq CMD_RAPIDO
    cpi temp, '-'
    breq CMD_LENTO
    rjmp MAIN
;_____________________________________________
CMD_SENAL8:
    cli
    ldi seleccion, 8
    ldi indice, 0
    sei
    ldi ZL, LOW(msg_senal8<<1)
    ldi ZH, HIGH(msg_senal8<<1)
    rcall uart_print
    rjmp MAIN
CMD_SENAL17:
    cli
    ldi seleccion, 17
    ldi indice, 0
    sei
    ldi ZL, LOW(msg_senal17<<1)
    ldi ZH, HIGH(msg_senal17<<1)
    rcall uart_print
    rjmp MAIN
CMD_RAPIDO:
    rcall MAS_RAPIDO
    ldi ZL, LOW(mensaje_rapido<<1)
    ldi ZH, HIGH(mensaje_rapido<<1)
    rcall uart_print
    rjmp MAIN
CMD_LENTO:
    rcall MAS_LENTO
    ldi ZL, LOW(mensaje_lento<<1)
    ldi ZH, HIGH(mensaje_lento<<1)
    rcall uart_print
    rjmp MAIN
;_____________________________________________
MAS_RAPIDO:
    lds temp, velocidad
    cpi temp, VEL_MIN
    breq RAPIDO_FIN
    brlo RAPIDO_FIN
    subi temp, PASO_VEL
    cpi temp, VEL_MIN
    brsh GUARDAR_RAPIDO
    ldi temp, VEL_MIN
GUARDAR_RAPIDO:
    sts velocidad, temp
    cli
    ldi aux, 0
    sts OCR1AH, aux
    sts OCR1AL, temp
    ldi aux, 0
    sts TCNT1H, aux
    sts TCNT1L, aux
    sei
RAPIDO_FIN:
    ret
;_____________________________________________
MAS_LENTO:
    lds temp, velocidad
    cpi temp, VEL_MAX
    breq LENTO_FIN
    brsh LENTO_FIN
    ldi aux, PASO_VEL
    add temp, aux
    cpi temp, VEL_MAX
    brlo GUARDAR_LENTO
    ldi temp, VEL_MAX
GUARDAR_LENTO:
    sts velocidad, temp
    cli
    ldi aux, 0
    sts OCR1AH, aux
    sts OCR1AL, temp
    ldi aux, 0
    sts TCNT1H, aux
    sts TCNT1L, aux
    sei
LENTO_FIN:
    ret
;_____________________________________________
TIMER1_ISR:
    push temp
    push dato
    push aux
    push r30
    push r31
    in temp, SREG
    push temp
    cpi seleccion, 8
    breq USAR_SENAL8
    cpi seleccion, 17
    breq USAR_SENAL17
    rjmp FIN_ISR
;_____________________________________________
USAR_SENAL8:
    cpi indice, 128
    brlo SENAL8_OK
    ldi indice, 0
;_____________________________________________
SENAL8_OK:
    ldi ZL, LOW(TABLA8<<1)
    ldi ZH, HIGH(TABLA8<<1)
    add ZL, indice
    clr temp
    adc ZH, temp
    lpm dato, Z
    rcall DAC_ESCRIBIR
    inc indice
    rjmp FIN_ISR
;_____________________________________________
USAR_SENAL17:
    ldi ZL, LOW(TABLA17<<1)
    ldi ZH, HIGH(TABLA17<<1)
    add ZL, indice
    clr temp
    adc ZH, temp
    lpm dato, Z
    rcall DAC_ESCRIBIR
    inc indice
;_____________________________________________
FIN_ISR:
    pop temp
    out SREG, temp
    pop r31
    pop r30
    pop aux
    pop dato
    pop temp
    reti
;_____________________________________________
DAC_ESCRIBIR:
    mov temp, dato
    lsl temp ; Mover
    lsl temp
    andi temp, 0b11111100
    in aux, PORTD
    andi aux, 0b00000011
    or temp, aux
    out PORTD, temp
    mov temp, dato
    lsr temp ; Mover
    lsr temp
    lsr temp ; Mover
    lsr temp
    lsr temp ; Mover
    lsr temp
    andi temp, 0b00000011
    in aux, PORTB
    andi aux, 0b11111100
	or temp, aux
    out PORTB, temp
    ret
;_____________________________________________
uart_init:
    ldi temp, HIGH(103)
    sts UBRR0H, temp
    ldi temp, LOW(103)
    sts UBRR0L, temp
    ldi temp, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, temp
    ldi temp, (1<<RXEN0)|(1<<TXEN0)
    sts UCSR0B, temp
    ret
;_____________________________________________
uart_tx:
UART_TX_WAIT:
    lds dato, UCSR0A
    sbrs dato, UDRE0
    rjmp UART_TX_WAIT
    sts UDR0, temp
    ret
;_____________________________________________
uart_rx:
UART_RX_WAIT:
    lds dato, UCSR0A
    sbrs dato, RXC0
    rjmp UART_RX_WAIT
    lds temp, UDR0
    ret
;_____________________________________________
uart_print:
    lpm temp, Z+
    cpi temp, 0
    breq UART_PRINT_FIN
	rcall uart_tx	
    rjmp uart_print
UART_PRINT_FIN:
    ret
;_____________________________________________
mostrar_menu:

    ldi ZL, LOW(menu_titulo<<1)
    ldi ZH, HIGH(menu_titulo<<1)
    rcall uart_print

    ldi ZL, LOW(menu_opcion1<<1)
    ldi ZH, HIGH(menu_opcion1<<1)
    rcall uart_print

    ldi ZL, LOW(menu_opcion2<<1)
    ldi ZH, HIGH(menu_opcion2<<1)
    rcall uart_print

    ldi ZL, LOW(menu_rapido<<1)
    ldi ZH, HIGH(menu_rapido<<1)
    rcall uart_print

    ldi ZL, LOW(menu_lento<<1)
    ldi ZH, HIGH(menu_lento<<1)
    rcall uart_print

    ldi ZL, LOW(menu_pedir<<1)
    ldi ZH, HIGH(menu_pedir<<1)
    rcall uart_print
    ret
;_____________________________________________
