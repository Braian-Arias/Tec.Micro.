;______________________________________________________________________
uart_init:

  ldi r16,HIGH(bps)
  sts UBRR0H,r16
  ldi r16,LOW(bps)
  sts UBRR0L,r16
  ldi r16,(1<<RXEN0)|(1<<TXEN0)
  sts UCSR0B,r16
  ldi r16,(1<<UCSZ01)|(1<<UCSZ00)
  sts UCSR0C,r16
  ret
;______________________________________________________________________
; Transmitir carácter por UART
uart_tx:
esperar_tx:
  lds r17,UCSR0A
  sbrs r17,UDRE0
  rjmp esperar_tx
  sts UDR0,r16
  ret
;______________________________________________________________________
; Recibir carácter por UART
uart_rx:
esperar_rx:
  lds r17,UCSR0A
  sbrs r17,RXC0
  rjmp esperar_rx
  lds r16,UDR0
  ret
;______________________________________________________________________
; Transmitir string desde memoria de programa (terminado en 0)
; Z = puntero
uart_print:
  lpm r16,Z+
  cpi r16,0
  breq uart_print_end
  rcall uart_tx
  rjmp uart_print
uart_print_end:
  ret
