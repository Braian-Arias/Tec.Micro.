.include "m328pdef.inc"
.equ VEL_INICIAL = 18
.equ VEL_MIN     = 4
.equ VEL_MAX     = 60
.dseg  
.org 0x0100
buffer:   
.byte 8  
velocidad:
.byte 1
.cseg 
.ORG 0x0000
.equ F_CPU = 16000000
.equ baud = 9600
.equ bps = (F_CPU/16/baud)-1
RJMP Inicio
;______________________________________________________________________
Inicio:
  ; Inicializar stack
  ldi r16,HIGH(RAMEND)
  out SPH,r16
  ldi r16,LOW(RAMEND)
  out SPL,r16
;______________________________________________________________________
  ;como todo es salida para la matriz menos tx y rx todo salida y despues defino
  ; PORTD: PD0 RX, PD1 TX, PD2-PD7 matriz
  ldi r16,0b11111100
  out DDRD,r16

  ; PORTB: PB0-PB5 matriz
  ldi r16,0b00111111
  out DDRB,r16

  ; PORTC: PC0-PC3 matriz
  ldi r16,0b00001111
  out DDRC,r16

  ; Velocidad inicial
  ldi r16, VEL_INICIAL
  sts velocidad, r16

  ; Inicializar UART
  rcall apagar_matriz
  rcall uart_init
;______________________________________________________________________
 ; Mostrar mensaje de bienvenida
  ldi ZL,LOW(mensaje_inicio<<1)
  ldi ZH,HIGH(mensaje_inicio<<1)
  rcall uart_print
;______________________________________________________________________
main_loop:
  rcall mostrar_menu
  ; Esperar y leer carácter
esperar_comando:
  rcall uart_rx

   ; Ignorar ENTER
   cpi r16, 0x0D
   breq esperar_comando
   cpi r16, 0x0A
   breq esperar_comando

  ; Comparar comando recibido
Comparar:
  cpi r16,'1'
  breq cmd1
  cpi r16,'2'
  breq cmd2
  cpi r16,'3'
  breq cmd3
  cpi r16,'p'
  breq cmd_palabra
  cpi r16,'P'
  breq cmd_palabra
  cpi r16,'+'
  breq cmd_rapido
  cpi r16,'-'
  breq cmd_lento
  rjmp esperar_comando

;______________________________________________________________________
cmd1:
  ldi ZL,LOW(mensaje_sonrisa<<1)
  ldi ZH,HIGH(mensaje_sonrisa<<1)
  rcall uart_print
  rcall sonrisa
  rjmp esperar_comando

cmd2:
  ldi ZL,LOW(mensaje_guino<<1)
  ldi ZH,HIGH(mensaje_guino<<1)
  rcall uart_print
  rcall guino
  rjmp esperar_comando

cmd3:
  ldi ZL,LOW(mensaje_corazon<<1)
  ldi ZH,HIGH(mensaje_corazon<<1)
  rcall uart_print
  rcall corazon
  rjmp esperar_comando

cmd_palabra:
 
  ldi ZL,LOW(mensaje_palabra<<1)
  ldi ZH,HIGH(mensaje_palabra<<1)
  rcall uart_print
  rcall palabra
  rjmp esperar_comando

mas_rapido:
    lds r16, velocidad
    cpi r16, VEL_MIN ; Menor valor = mas rapido
    breq rapido_fin
    brlo rapido_fin
    dec r16
    dec r16
    ; No permitir bajar del mínimo
    cpi r16, VEL_MIN
    brsh guardar_rapido
    ldi r16, VEL_MIN
guardar_rapido:
    sts velocidad, r16
rapido_fin:
    ret
cmd_rapido:
    rcall mas_rapido

    ldi ZL,LOW(mensaje_rapido<<1)
    ldi ZH,HIGH(mensaje_rapido<<1)
    rcall uart_print

    rjmp esperar_comando
mas_lento:
    lds r16, velocidad
    cpi r16, VEL_MAX ; Mayor valor = mas lento
    brsh lento_fin
    inc r16
    inc r16
    cpi r16, VEL_MAX
    brlo guardar_lento
    ldi r16, VEL_MAX
guardar_lento:
    sts velocidad, r16
lento_fin:
    ret
cmd_lento:
  rcall mas_lento
  ldi ZL,LOW(mensaje_lento<<1)
  ldi ZH,HIGH(mensaje_lento<<1)
  rcall uart_print
  rjmp esperar_comando
;______________________________________________________________________
mostrar_menu:

  ldi ZL,LOW(menu<<1)
  ldi ZH,HIGH(menu<<1)
  rcall uart_print
  ret
;______________________________________________________________________
uart_init:

  clr r16
  sts UBRR0H,r16
  ldi r16,LOW(bps)
  sts UBRR0L,r16
  ldi r16,(1<<RXEN0)|(1<<TXEN0)
  sts UCSR0B,r16
  ldi r16,(1<<UCSZ01)|(1<<UCSZ00)
  sts UCSR0C,r16
  ret
;______________________________________________________________________
; Transmitir carácter por UART
uart_tx:
esperar_tx:
  lds r17,UCSR0A
  sbrs r17,UDRE0
  rjmp esperar_tx
  sts UDR0,r16
  ret
;______________________________________________________________________
uart_rx_no_bloqueante:
   lds r17, UCSR0A
   sbrs r17, RXC0
   rjmp uart_no_hay
   lds r16, UDR0    
   sec
   ret
uart_no_hay:
   clc
   ret
;______________________________________________________________________
; Recibir carácter por UART
uart_rx:
esperar_rx:
  lds r17,UCSR0A
  sbrs r17,RXC0
  rjmp esperar_rx
  lds r16,UDR0
  ret
;______________________________________________________________________
; Transmitir string desde memoria de programa (terminado en 0)
; Z = puntero
uart_print:
  lpm r16,Z+
  cpi r16,0
  breq uart_print_end
  rcall uart_tx
  rjmp uart_print
uart_print_end:
  ret
