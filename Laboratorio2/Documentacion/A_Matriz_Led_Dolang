;______________________________________________________________________
; MOSTRAR LETRA
; Z = dirección de la letra
; Carga los 8 bytes de la letra en BUFFER
; y luego los muestra.
;______________________________________________________________________

mostrar_letra:

  ldi YL,LOW(buffer)
  ldi YH,HIGH(buffer)
  ldi r18,8

cargar_letra:

  lpm r16,Z+
  st Y+,r16
  dec r18
  brne cargar_letra

  ; Mostrar y desplazar
  ldi r23,8

movimiento_letra:
  rcall mostrar_buffer
  rcall desplazar
  dec r23
  brne movimiento_letra

  ret
;______________________________________________________________________

mostrar_buffer:

  ldi YL,LOW(buffer)
  ldi YH,HIGH(buffer)
  ldi r18,0

mostrar_buffer_fila:

  ld r16,Y+
  mov r17,r18
  rcall mostrar_fila_texto
  inc r18
  cpi r18,8
  brne mostrar_buffer_fila
  ret
;______________________________________________________________________
mostrar_fila_texto:

    mov r21,r16

    ldi r19,0b11111100
    out PORTD,r19

    ldi r19,0b00001111
    out PORTB,r19

    clr r19
    out PORTC,r19

    mov r19,r21
    andi r19,0b11000000
    lsr r19
    lsr r19
    ori r19,0b00001111
    out PORTB,r19

    mov r19,r21
    andi r19,0b00111111
    out PORTC,r19

    cpi r17,0
    brne revisar_f2_texto
    rjmp f1_texto

revisar_f2_texto:
    cpi r17,1
    brne revisar_f3_texto
    rjmp f2_texto

revisar_f3_texto:
    cpi r17,2
    brne revisar_f4_texto
    rjmp f3_texto

revisar_f4_texto:
    cpi r17,3
    brne revisar_f5_texto
    rjmp f4_texto

revisar_f5_texto:
    cpi r17,4
    brne revisar_f6_texto
    rjmp f5_texto

revisar_f6_texto:
    cpi r17,5
    brne revisar_f7_texto
    rjmp f6_texto

revisar_f7_texto:
    cpi r17,6
    brne usar_f8_texto
    rjmp f7_texto

usar_f8_texto:
    rjmp f8_texto

f1_texto:
    cbi PORTD,PD3
    rjmp mantener_texto

f2_texto:
    cbi PORTD,PD5
    rjmp mantener_texto

f3_texto:
    cbi PORTD,PD6
    rjmp mantener_texto

f4_texto:
    cbi PORTD,PD7
    rjmp mantener_texto

f5_texto:
    cbi PORTB,PB0
    rjmp mantener_texto

f6_texto:
    cbi PORTB,PB1
    rjmp mantener_texto

f7_texto:
    cbi PORTB,PB2
    rjmp mantener_texto

f8_texto:
    cbi PORTB,PB3
    rjmp mantener_texto
;______________________________________________________________________
desplazar:

  ldi YL,LOW(buffer)
  ldi YH,HIGH(buffer)
  ldi r18,8

desplazar_fila:
  ld r16,Y
  lsl r16
  st Y,r16
  adiw YL,1
  dec r18
  brne desplazar_fila
  ret
;______________________________________________________________________
; MOSTRAR UNA FILA
;
; r16 = dibujo de la fila
; r17 = numero de fila
;______________________________________________________________________

mostrar_fila:

    ; guardar dibujo
    mov r21, r16

    ; apagar F1-F4
    ; mantener pull-up D2 y D4

    ldi r19, 0b11111100
    out PORTD, r19


    ; apagar F5-F8
    ; apagar C1 y C2

    ldi r19, 0b00001111
    out PORTB, r19


    ; apagar C3-C8

    clr r19
    out PORTC, r19


    ; ----------------------------------------
    ; C1 y C2
    ;
    ; bit 7 -> C1
    ; bit 6 -> C2
    ; ----------------------------------------

    mov r19, r21
    andi r19, 0b11000000

    lsr r19
    lsr r19

    ori r19, 0b00001111

    out PORTB, r19


    ; ----------------------------------------
    ; C3 hasta C8
    ; ----------------------------------------

    mov r19, r21
    andi r19, 0b00111111

    out PORTC, r19


    ; elegir fila

    cpi r17, 0
    brne revisar_f2
    rjmp f1


revisar_f2:

    cpi r17, 1
    brne revisar_f3
    rjmp f2


revisar_f3:

    cpi r17, 2
    brne revisar_f4
    rjmp f3


revisar_f4:

    cpi r17, 3
    brne revisar_f5
    rjmp f4


revisar_f5:

    cpi r17, 4
    brne revisar_f6
    rjmp f5


revisar_f6:

    cpi r17, 5
    brne revisar_f7
    rjmp f6


revisar_f7:

    cpi r17, 6
    brne usar_f8
    rjmp f7


usar_f8:

    rjmp f8

; ----------------------------------------------------------
; FILAS
; ----------------------------------------------------------

f1:

    cbi PORTD, PD3
    rjmp mantener


f2:

    cbi PORTD, PD5
    rjmp mantener


f3:

    cbi PORTD, PD6
    rjmp mantener


f4:

    cbi PORTD, PD7
    rjmp mantener


f5:

    cbi PORTB, PB0
    rjmp mantener


f6:

    cbi PORTB, PB1
    rjmp mantener


f7:

    cbi PORTB, PB2
    rjmp mantener


f8:

    cbi PORTB, PB3

; -----------------------------------------------------------
; PAUSA PARA REFRESCAR MATRIZ
; -----------------------------------------------------------
mantener_texto:

    mov r20,r22

espera_texto:

    dec r20
    brne espera_texto

    ret

mantener:

    ldi r20, 60

espera:

    dec r20
    brne espera

    ret
