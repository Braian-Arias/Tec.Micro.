palabra:

    ; Comenzar desde la primera columna
    ldi r24, LOW(palabra_led<<1)
    ldi r25, HIGH(palabra_led<<1)
scroll_nueva_posicion:
    movw r30, r24
    lpm r16, Z
    cpi r16, 0xFF
    breq scroll_reiniciar
    movw r30, r24
    ldi XL, LOW(buffer)
    ldi XH, HIGH(buffer)
    ldi r18, 8
    ; r23 indica si encontramos el final
    clr r23

scroll_copiar:
    tst r23
    brne scroll_cero
    lpm r16, Z+
    cpi r16, 0xFF
    brne scroll_guardar
    ; Encontramos fin de mensaje
    ldi r23, 1

scroll_cero:
    clr r16
scroll_guardar:
    st X+, r16
    dec r18
    brne scroll_copiar
    lds r22, velocidad
scroll_refresco:
    rcall mostrar_frame
    ; Revisar UART sin detener la matriz
    rcall uart_rx_no_bloqueante
    ; Carry = 0 -> no llegó nada
    brcc scroll_sin_comando
    cpi r16, '+'
    breq scroll_rapido
    cpi r16, '-'
    breq scroll_lento
    cpi r16, 'M'
    breq scroll_salir
    cpi r16, 'm'
    breq scroll_salir

scroll_sin_comando:
    dec r22
    brne scroll_refresco
    ; Avanzar una columna
    adiw r24, 1
    rjmp scroll_nueva_posicion
scroll_rapido:
    rcall mas_rapido
    lds r22, velocidad
    rjmp scroll_refresco
scroll_lento:
    rcall mas_lento
    lds r22, velocidad
    rjmp scroll_refresco
scroll_reiniciar:
    ; Volver al inicio para hacerlo continuo
    ldi r24, LOW(palabra_led<<1)
    ldi r25, HIGH(palabra_led<<1)
    rjmp scroll_nueva_posicion
scroll_salir:
    rcall apagar_matriz
    ret
;___________________________________________________________________
apagar_matriz:

    push r16
    ; PD2-PD7
    in r16, PORTD
    andi r16, 0b00000011
    ori r16, 0b11111100
    out PORTD, r16

    ; PB0-PB1
    ; PB2-PB5
    in r16, PORTB
    andi r16, 0b11000000
    ori r16, 0b00000011
    out PORTB, r16

    ; PC0-PC3
    in r16, PORTC
    andi r16, 0b11110000
    out PORTC, r16
    pop r16
    ret
;______________________________________________________________________
activar_columna:

    cpi r19, 0
    breq activar_c1
    cpi r19, 1
    breq activar_c2
    cpi r19, 2
    breq activar_c3
    cpi r19, 3
    breq activar_c4
    cpi r19, 4
    breq activar_c5
    cpi r19, 5
    breq activar_c6
    cpi r19, 6
    breq activar_c7
    cpi r19, 7
    breq activar_c8
    ret

activar_c1:
    sbi PORTB, PB2
    ret
activar_c2:
    sbi PORTB, PB3
    ret
activar_c3:
    sbi PORTB, PB4
    ret
activar_c4:
    sbi PORTB, PB5
    ret
activar_c5:
    sbi PORTC, PC0
    ret
activar_c6:
    sbi PORTC, PC1
    ret
activar_c7:
    sbi PORTC, PC2
    ret
activar_c8:
    sbi PORTC, PC3
    ret
;______________________________________________________________________
poner_filas:

    push r17
    push r18
    mov r17, r16
    com r17
    andi r17, 0b00111111
    lsl r17
    lsl r17
    in r18, PORTD
    andi r18, 0b00000011
    or r18, r17
    out PORTD, r18
    mov r17, r16
    com r17
    ; Llevar bits 6 y 7 a posiciones 0 y 1
    lsr r17
    lsr r17
    lsr r17
    lsr r17
    lsr r17
    lsr r17
    andi r17, 0b00000011
    ; Preservar PB2-PB7
    in r18, PORTB
    andi r18, 0b11111100
    or r18, r17
    out PORTB, r18
    pop r18
    pop r17
    ret
;______________________________________________________________________
mostrar_frame:

    push r18
    push r19
    push r26
    push r27
    ; Apuntar al buffer
    ldi XL, LOW(buffer)
    ldi XH, HIGH(buffer)
    ; columna actual = 0
    clr r18
mostrar_frame_loop:

    rcall apagar_matriz
    ; Leer dibujo de la columna
    ld r16, X+
    rcall poner_filas
    mov r19, r18
    rcall activar_columna
    ; Mantener aproximadamente 1 ms
    rcall delay_1ms
    ; Siguiente columna
    inc r18
    cpi r18, 8
    brlo mostrar_frame_loop
    rcall apagar_matriz
    pop r27
    pop r26
    pop r19
    pop r18
    ret
;______________________________________________________________________
cargar_figura:
    ldi XL, LOW(buffer)
    ldi XH, HIGH(buffer)
    ldi r18, 8
cargar_figura_loop:
    lpm r16, Z+
    st X+, r16
    dec r18
    brne cargar_figura_loop
    ret
;______________________________________________________________________
mostrar_figura:

figura_loop:
    rcall mostrar_frame
    ; Revisar UART
    rcall uart_rx_no_bloqueante
    brcc figura_loop  
    cpi r16, 'M'
    breq figura_salir
    cpi r16, 'm'
    breq figura_salir
    rjmp figura_loop
figura_salir:
    rcall apagar_matriz
    ret
;______________________________________________________________________
delay_1ms:
    push r20
    push r21
    ldi r20, 21
delay_1:
    ldi r21, 250
delay_2:
    dec r21
    brne delay_2
    dec r20
    brne delay_1
    pop r21
    pop r20
    ret
