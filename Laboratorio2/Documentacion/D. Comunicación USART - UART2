;========================================================
; ATmega328P #2 - RECEPTOR
; USART -> DISPLAY 7 SEGMENTOS
;
; PD0 = RX
;
; PORTB:
; PB0 = segmento a
; PB1 = segmento b
; PB2 = segmento c
; PB3 = segmento d
; PB4 = segmento e
; PB5 = segmento f
; PB6 = segmento g
; PB7 = punto decimal
;
; Display: CÁTODO COMÚN
;
; F_CPU = 16 MHz
; Baud = 9600
;========================================================

.include "m328Pdef.inc"

.def temp = r16
.def dato = r17

.org 0x0000
    rjmp RESET


;========================================================
; TABLA LUT
;========================================================

TABLA:

    ;      abcdefg
    .db 0b00111111      ; 0
    .db 0b00000110      ; 1
    .db 0b01011011      ; 2
    .db 0b01001111      ; 3
    .db 0b01100110      ; 4
    .db 0b01101101      ; 5
    .db 0b01111101      ; 6
    .db 0b00000111      ; 7


;========================================================
; RESET
;========================================================

RESET:

    ; Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp


;--------------------------------------------------------
; PORTB como salida
;--------------------------------------------------------

    ldi temp, 0b11111111
    out DDRB, temp

    ; Apagar display
    clr temp
    out PORTB, temp


;--------------------------------------------------------
; USART
; 9600 baudios @ 16 MHz
;--------------------------------------------------------

    ldi temp, HIGH(103)
    sts UBRR0H, temp

    ldi temp, LOW(103)
    sts UBRR0L, temp

    ; Habilitar receptor
    ldi temp, (1<<RXEN0)
    sts UCSR0B, temp

    ; 8 bits, 1 stop, sin paridad
    ldi temp, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, temp


;========================================================
; PROGRAMA PRINCIPAL
;========================================================

MAIN:

    ; Recibir dato
    rcall USART_RX

    ; dato = 0 al 7

    ;--------------------------------------------
    ; Buscar dato en la tabla
    ;--------------------------------------------

    ldi ZH, HIGH(TABLA<<1)
    ldi ZL, LOW(TABLA<<1)

    ; Z = dirección de tabla + dato
    add ZL, dato

    ldi temp, 0
    adc ZH, temp

    ; Leer patrón del display
    lpm temp, Z

    ; Mostrar
    out PORTB, temp

    rjmp MAIN


;========================================================
; RECEPCIÓN USART
; Salida: dato = 0...7
;========================================================

USART_RX:

ESPERAR_RX:

    lds temp, UCSR0A

    ; Esperar hasta recibir
    sbrs temp, RXC0
    rjmp ESPERAR_RX

    ; Leer dato
    lds dato, UDR0

    ; Solo 3 bits
    andi dato, 0b00000111

    ret
