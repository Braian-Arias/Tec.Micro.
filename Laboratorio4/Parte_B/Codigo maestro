
#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdio.h>

// ====================================
// COMANDOS SPI
// ====================================
#define CMD_START       1
#define CMD_STOP        2
#define CMD_EMERGENCIA  3
#define CMD_RESET       4
#define CMD_VELOCIDAD   5
#define CMD_PISTON      6

// ====================================
// CONFIGURACION
// ====================================
#define LCD_ADDR       0x27
#define TEMP_MAX       40
#define LDR_DETECTA    420
#define LDR_LIBERA     550

#define BOTON          PD2
#define DHT_PIN        PB1
#define SPI_SS         PB2

// Mapeo PCF8574:
// P0=RS, P1=RW, P2=E, P3=Luz
// P4-P7 = D4-D7
#define LCD_RS         0x01
#define LCD_E          0x04
#define LCD_LUZ        0x08

volatile uint32_t tiempoMs = 0;

uint8_t marcha = 0;
uint8_t emergencia = 0;
uint8_t velocidad = 180;
uint8_t temperatura = 255;
uint8_t piezaPresente = 0;
uint8_t errorDHT = 0;
uint16_t contadorPiezas = 0;

// ====================================
// TIMER0: RELOJ EN MILISEGUNDOS
// ====================================
ISR(TIMER0_COMPA_vect) {
    tiempoMs++;
}

void timer_init(void) {
    TCCR0A = (1 << WGM01);
    TCCR0B = (1 << CS01) | (1 << CS00);
    OCR0A = 249;
    TIMSK0 = (1 << OCIE0A);
}

uint32_t millis_avr(void) {
    uint32_t valor;
    uint8_t previo = SREG;

    cli();
    valor = tiempoMs;
    SREG = previo;

    return valor;
}

// ====================================
// UART A 9600 BAUDIOS
// ====================================
void uart_init(void) {
    UBRR0H = 0;
    UBRR0L = 103;

    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void uart_print(const char *texto) {
    while (*texto) {
        while (!(UCSR0A & (1 << UDRE0)));
        UDR0 = *texto++;
    }
}

// ====================================
// ADC: LDR Y POTENCIOMETRO
// ====================================
void adc_init(void) {
    ADMUX = (1 << REFS0);

    ADCSRA = (1 << ADEN)
           | (1 << ADPS2)
           | (1 << ADPS1)
           | (1 << ADPS0);
}

uint16_t adc_leer(uint8_t canal) {
    ADMUX = (1 << REFS0) | (canal & 0x07);

    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC));

    return ADC;
}

// ====================================
// SPI MAESTRO DE HARDWARE
// ====================================
void spi_init(void) {
    DDRB |= (1 << PB2)
          | (1 << PB3)
          | (1 << PB5);

    DDRB &= ~(1 << PB4);

    PORTB |= (1 << SPI_SS);

    // Modo 0, maestro, 125 kHz
    SPCR = (1 << SPE)
         | (1 << MSTR)
         | (1 << SPR1)
         | (1 << SPR0);
}

uint8_t spi_transfer(uint8_t dato) {
    SPDR = dato;

    while (!(SPSR & (1 << SPIF)));

    return SPDR;
}

void enviarSPI(uint8_t comando, uint8_t valor) {
    PORTB &= ~(1 << SPI_SS);
    _delay_us(50);

    spi_transfer(comando);
    _delay_us(100);
    spi_transfer(valor);

    _delay_us(100);
    PORTB |= (1 << SPI_SS);

    // Tiempo para procesar la trama
    _delay_ms(2);
}

// ====================================
// I2C / TWI MAESTRO
// ====================================
void i2c_init(void) {
    DDRC &= ~((1 << PC4) | (1 << PC5));

    PORTC |= (1 << PC4) | (1 << PC5);

    TWSR = 0;
    TWBR = 72; // 100 kHz
    TWCR = (1 << TWEN);
}

// Espera limitada para evitar bloqueo
uint8_t i2c_esperar(void) {
    uint16_t limite = 60000;

    while (!(TWCR & (1 << TWINT))) {
        if (--limite == 0)
            return 0;
    }

    return 1;
}

uint8_t i2c_start(void) {
    TWCR = (1 << TWINT)
         | (1 << TWSTA)
         | (1 << TWEN);

    return i2c_esperar();
}

uint8_t i2c_write(uint8_t dato) {
    TWDR = dato;

    TWCR = (1 << TWINT)
         | (1 << TWEN);

    return i2c_esperar();
}

void i2c_stop(void) {
    TWCR = (1 << TWINT)
         | (1 << TWSTO)
         | (1 << TWEN);
}

// ====================================
// LCD 16x2 I2C / PCF8574
// ====================================
uint8_t lcd_expander(uint8_t dato) {
    uint8_t ok = 1;

    if (!i2c_start())
        return 0;

    if (!i2c_write(LCD_ADDR << 1))
        ok = 0;

    if (ok && !i2c_write(dato | LCD_LUZ))
        ok = 0;

    i2c_stop();
    return ok;
}

void lcd_pulso(uint8_t dato) {
    lcd_expander(dato | LCD_E);
    _delay_us(3);

    lcd_expander(dato & ~LCD_E);
    _delay_us(80);
}

void lcd_nibble(uint8_t dato, uint8_t rs) {
    lcd_pulso((dato & 0xF0) | rs);
}

void lcd_enviar(uint8_t dato, uint8_t rs) {
    lcd_nibble(dato, rs);
    lcd_nibble(dato << 4, rs);
}

void lcd_cmd(uint8_t comando) {
    lcd_enviar(comando, 0);

    if (comando == 0x01 || comando == 0x02)
        _delay_ms(2);
}

void lcd_char(char caracter) {
    lcd_enviar((uint8_t)caracter, LCD_RS);
}

void lcd_linea(uint8_t fila, const char *texto) {
    lcd_cmd(fila == 0 ? 0x80 : 0xC0);

    uint8_t i = 0;

    while (*texto && i < 16) {
        lcd_char(*texto++);
        i++;
    }

    while (i < 16) {
        lcd_char(' ');
        i++;
    }
}

void lcd_init(void) {
    _delay_ms(50);

    lcd_nibble(0x30, 0);
    _delay_ms(5);

    lcd_nibble(0x30, 0);
    _delay_us(200);

    lcd_nibble(0x30, 0);
    lcd_nibble(0x20, 0);

    lcd_cmd(0x28);
    lcd_cmd(0x08);
    lcd_cmd(0x01);
    lcd_cmd(0x06);
    lcd_cmd(0x0C);
}

void actualizarLCD(void) {
    char linea[17];

    if (emergencia) {
        lcd_linea(0, "EMERGENCIA");
    }
    else if (marcha) {
        lcd_linea(0, "BANDA EN MARCHA");
    }
    else {
        lcd_linea(0, "BANDA DETENIDA");
    }

    // Alternar informacion en fila 2
    if ((millis_avr() / 2500UL) % 2 == 0) {
        snprintf(linea, sizeof(linea),
                 "PIEZAS:%u PWM:%u",
                 contadorPiezas, velocidad);
    }
    else {
        if (temperatura == 255) {
            snprintf(linea, sizeof(linea),
                     "TEMP: SIN DATO");
        }
        else {
            snprintf(linea, sizeof(linea),
                     "TEMP: %u C",
                     temperatura);
        }
    }

    lcd_linea(1, linea);
}

// ====================================
// SENSOR DHT11
// ====================================
// Esperar que termine un nivel digital.
// Retorna 0 si hay timeout.
uint8_t dht_esperar(uint8_t nivel) {
    uint8_t cuenta = 0;

    while (((PINB & (1 << DHT_PIN)) ? 1 : 0)
           == nivel) {

        _delay_us(1);
        cuenta++;

        if (cuenta >= 110)
            return 0;
    }

    return 1;
}

uint8_t dht_leer(uint8_t *temperaturaNueva) {
    uint8_t datos[5] = {0, 0, 0, 0, 0};
    uint8_t correcto = 1;

    // La lectura requiere tiempos precisos
    uint8_t previo = SREG;
    cli();

    // Solicitud al DHT11
    DDRB |= (1 << DHT_PIN);
    PORTB &= ~(1 << DHT_PIN);
    _delay_ms(20);

    // Liberar linea
    DDRB &= ~(1 << DHT_PIN);
    PORTB |= (1 << DHT_PIN);
    _delay_us(30);

    if (!dht_esperar(1) ||
        !dht_esperar(0) ||
        !dht_esperar(1)) {

        correcto = 0;
    }
    else {
        // Leer 40 bits
        for (uint8_t i = 0; i < 40; i++) {
            if (!dht_esperar(0)) {
                correcto = 0;
                break;
            }

            _delay_us(40);

            uint8_t bitActual =
                (PINB & (1 << DHT_PIN)) ? 1 : 0;

            datos[i / 8] =
                (datos[i / 8] << 1) | bitActual;

            if (bitActual && !dht_esperar(1)) {
                correcto = 0;
                break;
            }
        }
    }

    SREG = previo;

    if (!correcto)
        return 0;

    uint8_t suma = datos[0] + datos[1]
                 + datos[2] + datos[3];

    if (suma != datos[4])
        return 0;

    *temperaturaNueva = datos[2];
    return 1;
}

// ====================================
// LOGICA DEL PROCESO
// ====================================
void activarEmergencia(void) {
    if (emergencia)
        return;

    emergencia = 1;
    marcha = 0;

    enviarSPI(CMD_EMERGENCIA, 1);
    uart_print("EMERGENCIA ACTIVADA\r\n");
    actualizarLCD();
}

int main(void) {
    uint32_t tADC = 0;
    uint32_t tDHT = 0;
    uint32_t tLCD = 0;
    uint32_t tBoton = 0;

    uint8_t botonAnterior = 1;

    // Pulsador PD2 a GND
    DDRD &= ~(1 << BOTON);
    PORTD |= (1 << BOTON);

    timer_init();
    uart_init();
    adc_init();
    spi_init();
    i2c_init();

    // Iniciar con la LCD
    lcd_init();
    lcd_linea(0, "BANDA INDUSTRIAL");
    lcd_linea(1, "INICIANDO...");

    sei();

    uart_print("MAESTRO INICIADO\r\n");
    uart_print("E=EMERGENCIA R=RESET\r\n");

    _delay_ms(1000);

    enviarSPI(CMD_STOP, 0);
    actualizarLCD();

    while (1) {
        uint32_t ahora = millis_avr();

        // ---------------------------
        // PULSADOR START / STOP
        // ---------------------------
        uint8_t botonActual =
            (PIND & (1 << BOTON)) ? 1 : 0;

        if (botonAnterior && !botonActual &&
            (ahora - tBoton >= 150)) {

            tBoton = ahora;

            if (!emergencia) {
                marcha = !marcha;

                if (marcha) {
                    enviarSPI(CMD_START, 1);
                    uart_print("START\r\n");
                }
                else {
                    enviarSPI(CMD_STOP, 0);
                    uart_print("STOP\r\n");
                }

                actualizarLCD();
            }
        }

        botonAnterior = botonActual;

        // ---------------------------
        // COMANDOS POR UART
        // ---------------------------
        if (UCSR0A & (1 << RXC0)) {
            char c = UDR0;

            if (c == 'E' || c == 'e') {
                activarEmergencia();
            }

            if (c == 'R' || c == 'r') {
                // Rearmar solo si la temperatura
                // es valida y esta bajo el limite
                if (temperatura != 255 &&
                    temperatura <= TEMP_MAX) {

                    emergencia = 0;
                    marcha = 0;
                    errorDHT = 0;

                    enviarSPI(CMD_RESET, 0);
                    uart_print("REARMADO\r\n");
                    actualizarLCD();
                }
                else {
                    uart_print(
                      "NO SE PUEDE REARMAR\r\n");
                }
            }
        }

        // ---------------------------
        // POTENCIOMETRO Y LDR
        // ---------------------------
        if (ahora - tADC >= 250) {
            tADC = ahora;

            uint16_t pot = adc_leer(1);
            uint16_t ldr = adc_leer(0);

            velocidad = (uint8_t)(pot >> 2);

            if (marcha && !emergencia) {
                enviarSPI(CMD_VELOCIDAD,
                          velocidad);

                if (!piezaPresente &&
                    ldr < LDR_DETECTA) {

                    piezaPresente = 1;
                    contadorPiezas++;

                    enviarSPI(CMD_PISTON, 1);
                    uart_print("PIEZA DETECTADA\r\n");
                }
            }

            if (ldr > LDR_LIBERA) {
                piezaPresente = 0;
            }
        }

        // ---------------------------
        // TEMPERATURA DEL MOTOR
        // ---------------------------
        if (ahora - tDHT >= 2000) {
            tDHT = ahora;

            uint8_t nuevaTemp;

            if (dht_leer(&nuevaTemp)) {
                temperatura = nuevaTemp;
                errorDHT = 0;

                if (temperatura > TEMP_MAX) {
                    activarEmergencia();
                }
            }
            else {
                temperatura = 255;

                if (errorDHT < 3)
                    errorDHT++;

                if (errorDHT >= 3)
                    activarEmergencia();
            }
        }

        // ---------------------------
        // ACTUALIZAR PANTALLA
        // ---------------------------
        if (ahora - tLCD >= 500) {
            tLCD = ahora;
            actualizarLCD();
        }

        _delay_ms(5);
    }
}
