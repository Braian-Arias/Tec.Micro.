#define F_CPU 16000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>

// Comandos SPI
#define CMD_START       1
#define CMD_STOP        2
#define CMD_EMERGENCIA  3
#define CMD_RESET       4
#define CMD_VELOCIDAD   5
#define CMD_PISTON      6

// Pines del motor
#define MOTOR_EN        PD3
#define MOTOR_IN1       PD7
#define MOTOR_IN2       PB0
// Indicadores
#define LED_VERDE       PD4
#define LED_ROJO        PD5
#define BUZZER          PD6

// Servomotor
#define SERVO_PIN       PB1
// Variables SPI

volatile uint8_t comandoSPI = 0;
volatile uint8_t valorSPI = 0;
volatile uint8_t etapaSPI = 0;
volatile uint8_t datoDisponible = 0;
// Temporizacion
volatile uint32_t ticksMedioMs = 0;
volatile uint8_t alarmaSonora = 0;
// Estado del proceso
uint8_t marcha = 0;
uint8_t emergencia = 0;
uint8_t velocidad = 180;
uint8_t pistonActivo = 0;
uint32_t tiempoPiston = 0;

// Interrupcion: un byte recibido por SPI
ISR(SPI_STC_vect) {
    uint8_t dato = SPDR;

    if (etapaSPI == 0) {
        comandoSPI = dato;
        etapaSPI = 1;
    } else {
        valorSPI = dato;
        datoDisponible = 1;
        etapaSPI = 0;
    }
}

// Reiniciar la recepcion cuando SS sube
ISR(PCINT0_vect) {
    if (PINB & (1 << PB2)) {
        etapaSPI = 0;
    }
}

// Temporizador: interrupcion cada 500 us
ISR(TIMER0_COMPA_vect) {
    ticksMedioMs++;

    if (alarmaSonora) {
        PORTD ^= (1 << BUZZER);
    } else {
        PORTD &= ~(1 << BUZZER);
    }
}

uint32_t millisAVR(void) {
    uint32_t ticks;
    uint8_t sreg = SREG;
    cli();
    ticks = ticksMedioMs;
    SREG = sreg;
    return ticks / 2;
}
// Configuracion de temporizador del buzzer
void timer0_init(void) {
    TCCR0A = (1 << WGM01);
    TCCR0B = (1 << CS01) | (1 << CS00);
    OCR0A = 124;
    TIMSK0 = (1 << OCIE0A);
}

// PWM para motor DC en PD3 (OC2B)
void motor_pwm_init(void) {
    DDRD |= (1 << MOTOR_EN);

    // Fast PWM de 8 bits, salida OC2B
    TCCR2A = (1 << COM2B1)
           | (1 << WGM21)
           | (1 << WGM20);
    TCCR2B = (1 << CS22);
    OCR2B = 0;
}

void motor_detener(void) {
    OCR2B = 0;
    PORTD &= ~(1 << MOTOR_IN1);
    PORTB &= ~(1 << MOTOR_IN2);
}

void motor_arrancar(void) {
    if (marcha && !emergencia) {
        PORTD |= (1 << MOTOR_IN1);
        PORTB &= ~(1 << MOTOR_IN2);
        OCR2B = velocidad;
    }
}

// Servo mediante Timer1 y OC1A (PB1)
void servo_init(void) {
    DDRB |= (1 << SERVO_PIN);
    // PWM de 50 Hz, prescaler 8
    // Periodo = 20 ms
    ICR1 = 39999;

    // Posicion inicial: pulso de 1 ms
    OCR1A = 2000;
    TCCR1A = (1 << COM1A1) | (1 << WGM11);
    TCCR1B = (1 << WGM13)
           | (1 << WGM12)
           | (1 << CS11);
}

void piston_extender(void) {
    // Pulso de 2 ms
    OCR1A = 4000;
    pistonActivo = 1;
    tiempoPiston = millisAVR();
}

void piston_retraer(void) {
    // Pulso de 1 ms
    OCR1A = 2000;
    pistonActivo = 0;
}

// Actualizar estados de salidas
void actualizar_salidas(void) {
    if (emergencia) {
        motor_detener();
        piston_retraer();
        PORTD &= ~(1 << LED_VERDE);
        PORTD |= (1 << LED_ROJO);
        alarmaSonora = 1;
    }
    else if (marcha) {
        motor_arrancar();

        PORTD |= (1 << LED_VERDE);
        PORTD &= ~(1 << LED_ROJO);

        alarmaSonora = 0;
    }
    else {
        motor_detener();

        PORTD &= ~(1 << LED_VERDE);
        PORTD |= (1 << LED_ROJO);

        alarmaSonora = 0;
    }
}

// SPI esclavo de hardware
void spi_init(void) {
    // SS, MOSI y SCK son entradas
    DDRB &= ~((1 << PB2)
            | (1 << PB3)
            | (1 << PB5));

    // MISO es salida
    DDRB |= (1 << PB4);

    // SPI esclavo con interrupcion
    SPCR = (1 << SPE) | (1 << SPIE);

    // Interrupcion por cambios en SS
    PCICR |= (1 << PCIE0);
    PCMSK0 |= (1 << PCINT2);
}

// Procesar trama SPI [comando][valor]
void procesar_comando(uint8_t comando,
                     uint8_t valor) {

    switch (comando) {

        case CMD_START:
            if (!emergencia && valor == 1) {
                marcha = 1;
            }
            break;

        case CMD_STOP:
            marcha = 0;
            break;

        case CMD_EMERGENCIA:
            emergencia = 1;
            marcha = 0;
            break;

        case CMD_RESET:
            emergencia = 0;
            marcha = 0;
            break;

        case CMD_VELOCIDAD:
            velocidad = valor;

            if (marcha && !emergencia) {
                OCR2B = velocidad;
            }
            break;

        case CMD_PISTON:
            if (marcha && !emergencia && valor == 1) {
                piston_extender();
            }
            break;

        default:
            break;
    }

    actualizar_salidas();
}

int main(void) {
    uint8_t comando;
    uint8_t valor;
    uint8_t recibido;

    // LEDs, buzzer y motor
    DDRD |= (1 << LED_VERDE)
          | (1 << LED_ROJO)
          | (1 << BUZZER)
          | (1 << MOTOR_IN1);

    DDRB |= (1 << MOTOR_IN2);

    PORTD &= ~((1 << LED_VERDE)
             | (1 << LED_ROJO)
             | (1 << BUZZER)
             | (1 << MOTOR_IN1));

    PORTB &= ~(1 << MOTOR_IN2);

    timer0_init();
    motor_pwm_init();
    servo_init();
    spi_init();

    motor_detener();
    actualizar_salidas();

    sei();

    while (1) {
        // Leer los dos bytes recibidos
        uint8_t sreg = SREG;
        cli();

        recibido = datoDisponible;
        comando = comandoSPI;
        valor = valorSPI;

        datoDisponible = 0;
        SREG = sreg;

        if (recibido) {
            procesar_comando(comando, valor);
        }

        // Retraer el piston despues de 350 ms
        if (pistonActivo) {
            uint32_t ahora = millisAVR();

            if (ahora - tiempoPiston >= 350) {
                piston_retraer();
            }
        }
    }
}
