
#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <stdint.h>

// ====================================
// COMANDOS
// ====================================
#define CMD_START       1
#define CMD_STOP        2
#define CMD_EMERGENCIA  3
#define CMD_RESET       4
#define CMD_VELOCIDAD   5
#define CMD_PISTON      6

// ====================================
// PINES
// ====================================
#define MOTOR_EN    PD3
#define MOTOR_IN1   PD7
#define MOTOR_IN2   PB0

#define LED_VERDE   PD4
#define LED_ROJO    PD5
#define BUZZER      PD6

#define SERVO       PB1

// ====================================
// VARIABLES
// ====================================
volatile uint8_t spiComando = 0;
volatile uint8_t spiValor = 0;
volatile uint8_t spiEtapa = 0;
volatile uint8_t spiDisponible = 0;

volatile uint32_t tiempoMs = 0;
volatile uint8_t sonar = 0;

uint8_t marcha = 0;
uint8_t emergencia = 0;
uint8_t velocidadMotor = 180;
uint8_t pistonActivo = 0;

uint32_t tiempoPiston = 0;

// ====================================
// INTERRUPCION SPI
// ====================================
ISR(SPI_STC_vect) {
    uint8_t dato = SPDR;

    if (spiEtapa == 0) {
        spiComando = dato;
        spiEtapa = 1;
    }
    else {
        spiValor = dato;
        spiDisponible = 1;
        spiEtapa = 0;
    }
}

// Reiniciar trama cuando termina SS
ISR(PCINT0_vect) {
    if (PINB & (1 << PB2))
        spiEtapa = 0;
}

// ====================================
// TIMER0: TIEMPO Y BUZZER
// ====================================
ISR(TIMER0_COMPA_vect) {
    tiempoMs++;

    if (sonar) {
        // Alternar cada 1 ms: 500 Hz
        PORTD ^= (1 << BUZZER);
    }
    else {
        PORTD &= ~(1 << BUZZER);
    }
}

void timer0_init(void) {
    TCCR0A = (1 << WGM01);
    TCCR0B = (1 << CS01) | (1 << CS00);

    OCR0A = 249;
    TIMSK0 = (1 << OCIE0A);
}

uint32_t millis_avr(void) {
    uint32_t valor;
    uint8_t previo = SREG;

    cli();
    valor = tiempoMs;
    SREG = previo;

    return valor;
}

// ====================================
// MOTOR DC - L293D
// PWM MEDIANTE TIMER2
// ====================================
void motor_init(void) {
    DDRD |= (1 << MOTOR_EN)
          | (1 << MOTOR_IN1);

    DDRB |= (1 << MOTOR_IN2);

    TCCR2A = (1 << COM2B1)
           | (1 << WGM21)
           | (1 << WGM20);

    TCCR2B = (1 << CS22);

    OCR2B = 0;
}

void motor_detener(void) {
    OCR2B = 0;

    PORTD &= ~(1 << MOTOR_IN1);
    PORTB &= ~(1 << MOTOR_IN2);
}

void motor_arrancar(void) {
    if (!marcha || emergencia)
        return;

    PORTD |= (1 << MOTOR_IN1);
    PORTB &= ~(1 << MOTOR_IN2);

    OCR2B = velocidadMotor;
}

// ====================================
// SERVOMOTOR - TIMER1
// ====================================
void servo_init(void) {
    DDRB |= (1 << SERVO);

    TCCR1A = 0;
    TCCR1B = 0;

    // 50 Hz a 16 MHz, prescaler 8
    ICR1 = 39999;

    // Posicion inicial: 1 ms
    OCR1A = 2000;

    TCCR1A = (1 << COM1A1)
           | (1 << WGM11);

    TCCR1B = (1 << WGM13)
           | (1 << WGM12)
           | (1 << CS11);
}

void servo_retraer(void) {
    OCR1A = 2000;
    pistonActivo = 0;
}

void servo_extender(void) {
    OCR1A = 4000;

    pistonActivo = 1;
    tiempoPiston = millis_avr();
}

// ====================================
// SPI ESCLAVO DE HARDWARE
// ====================================
void spi_init(void) {
    // Entradas SS, MOSI y SCK
    DDRB &= ~((1 << PB2)
            | (1 << PB3)
            | (1 << PB5));

    // Salida MISO
    DDRB |= (1 << PB4);

    // Activar SPI e interrupcion
    SPCR = (1 << SPE) | (1 << SPIE);

    // Interrupcion por cambio de SS
    PCICR |= (1 << PCIE0);
    PCMSK0 |= (1 << PCINT2);
}

// ====================================
// ACTUALIZAR SALIDAS
// ====================================
void actualizarSalidas(void) {
    if (emergencia) {
        motor_detener();
        servo_retraer();

        PORTD &= ~(1 << LED_VERDE);
        PORTD |= (1 << LED_ROJO);

        sonar = 1;
    }
    else if (marcha) {
        motor_arrancar();

        PORTD |= (1 << LED_VERDE);
        PORTD &= ~(1 << LED_ROJO);

        sonar = 0;
    }
    else {
        motor_detener();

        PORTD &= ~(1 << LED_VERDE);
        PORTD |= (1 << LED_ROJO);

        sonar = 0;
    }
}

// ====================================
// PROCESAR COMANDOS
// ====================================
void procesarComando(uint8_t comando,
                    uint8_t valor) {

    switch (comando) {

        case CMD_START:
            if (!emergencia && valor == 1) {
                marcha = 1;
            }
            break;

        case CMD_STOP:
            marcha = 0;
            servo_retraer();
            break;

        case CMD_EMERGENCIA:
            emergencia = 1;
            marcha = 0;
            servo_retraer();
            break;

        case CMD_RESET:
            emergencia = 0;
            marcha = 0;
            servo_retraer();
            break;

        case CMD_VELOCIDAD:
            velocidadMotor = valor;
            break;

        case CMD_PISTON:
            if (marcha && !emergencia &&
                valor == 1) {

                servo_extender();
            }
            break;

        default:
            break;
    }

    actualizarSalidas();
}

// ====================================
// PROGRAMA PRINCIPAL
// ====================================
int main(void) {
    uint8_t comando;
    uint8_t valor;
    uint8_t recibido;

    // Indicadores y buzzer
    DDRD |= (1 << LED_VERDE)
          | (1 << LED_ROJO)
          | (1 << BUZZER);

    PORTD &= ~((1 << LED_VERDE)
             | (1 << LED_ROJO)
             | (1 << BUZZER));

    timer0_init();
    motor_init();
    servo_init();
    spi_init();

    // Estado inicial
    actualizarSalidas();

    sei();

    while (1) {
        uint8_t previo = SREG;
        cli();

        recibido = spiDisponible;
        comando = spiComando;
        valor = spiValor;

        spiDisponible = 0;

        SREG = previo;

        if (recibido) {
            procesarComando(comando, valor);
        }

        // Retraer el piston despues de 350 ms
        if (pistonActivo) {
            uint32_t ahora = millis_avr();

            if (ahora - tiempoPiston >= 350) {
                servo_retraer();
            }
        }
    }
}
