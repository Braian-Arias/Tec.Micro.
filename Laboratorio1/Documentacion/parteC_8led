.include "m328pdef.inc"
.def SEQ = r16          ; número de secuencia 1..7
.def LED = r23          ; patrón de los LEDs

.org 0x0000
    rjmp Inicio

Inicio:

    ;----------------------------------------------------
    ; Configurar PORTD como salida led
    ;----------------------------------------------------

    ldi r17, 0b11111111
    out DDRD, r17

    ;----------------------------------------------------
    ; Configurar PORTC como entrada boton
    ;----------------------------------------------------

    ldi r17, 0b00000000
    out DDRC, r17

    ; Pull-up interno en PC0, PC1 y PC2
    ldi r17, (1<<PORTC0)|(1<<PORTC1)|(1<<PORTC2)
    out PORTC, r17

    ;----------------------------------------------------
    ; Configurar Stack
    ;----------------------------------------------------

    ldi r17, HIGH(RAMEND)
    out SPH, r17

    ldi r17, LOW(RAMEND)
    out SPL, r17

    ;----------------------------------------------------
    ; Comenzar en secuencia 1 y off
    ;----------------------------------------------------

    ldi SEQ, 1

    ; Apagar LEDs
    ldi LED, 0
    out PORTD, LED

MAIN:
    ;----------------------------------------------------
    ; Elegir secuencia
    ;----------------------------------------------------

    cpi SEQ, 1
    breq SEC1
	rjmp BUSCAR_BOTON

    cpi SEQ, 2
    breq SEC2
	rjmp BUSCAR_BOTON

    cpi SEQ, 3
    breq SEC3
	rjmp BUSCAR_BOTON

    cpi SEQ, 4
    breq SEC4
	rjmp BUSCAR_BOTON

    cpi SEQ, 5
    breq SEC5
	rjmp BUSCAR_BOTON

    rjmp menu1

    ; Si pasa algo raro
    ldi SEQ, 1
	rjmp BUSCAR_BOTON

    rjmp MAIN


;========================================================
; SECUENCIA 1
;
; TODOS ON 1 SEGUNDO
; TODOS OFF 1 SEGUNDO
;========================================================

SEC1:

    ; todos ON
    ldi LED, 0b11111111
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON

    ; todos OFF
    ldi LED, 0b00000000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC1


;========================================================
; SECUENCIA 2
;
; TODOS ON 2 SEGUNDOS
; TODOS OFF 2 SEGUNDOS
;========================================================

SEC2:

    ; todos ON
    ldi LED, 0b11111111
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON  

    ; todos OFF
    ldi LED, 0b00000000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC2


;========================================================
; SECUENCIA 3
;
; LED 1-4 ON
; LED 5-8 OFF
; 2 SEGUNDOS
;
; LED 1-4 OFF
; LED 5-8 ON
; 2 SEGUNDOS
;========================================================

SEC3:

    ; LED 1-4 ON
    ldi LED, 0b00001111
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    ; LED 1-4 OFF
    ; LED 5-8 ON
    ldi LED, 0b11110000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC3

;========================================================
; SECUENCIA 4
;
; INVERSA DE SEC3
;========================================================

SEC4:

    ; LED 1-4 OFF
    ; LED 5-8 ON
    ldi LED, 0b11110000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    ; LED 1-4 ON
    ; LED 5-8 OFF
    ldi LED, 0b00001111
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC4

menu1:
    cpi SEQ, 6
    breq SEC6
	rjmp BUSCAR_BOTON

    cpi SEQ, 7
    breq SEC7
	rjmp BUSCAR_BOTON
	ret
;========================================================
; SECUENCIA 5
;
; LED 1-2 ON
; LED 3-4 OFF
; LED 5-6 ON
; LED 7-8 OFF
;
; 2 SEGUNDOS
;
; TODOS OFF
; 2 SEGUNDOS
;========================================================

SEC5:

    ldi LED, 0b00110011
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    ; todos OFF
    ldi LED, 0b00000000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC5


;========================================================
; SECUENCIA 6
;
; INVERSA DE SEC5
;
; LED 1-2 OFF
; LED 3-4 ON
; LED 5-6 OFF
; LED 7-8 ON
;========================================================

SEC6:

    ldi LED, 0b11001100
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    ; todos OFF
    ldi LED, 0b00000000
    out PORTD, LED

    rcall Delay
	rjmp BUSCAR_BOTON
    rcall Delay
	rjmp BUSCAR_BOTON

    rjmp SEC6


;========================================================
; SECUENCIA 7
;
; COMIENZA TODO APAGADO
;
; LED1
; LED1+LED2
; LED1+LED2+LED3
; ...
; TODOS ENCENDIDOS
;========================================================

SEC7:

    ; comenzar apagado
    ldi LED, 0
    out PORTD, LED
	rjmp BUSCAR_BOTON

    ori LED, 0b00000001
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b00000010
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b00000100
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b00001000
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b00010000
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b00100000
    out PORTD, LED
	rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b01000000
    out PORTD, LED
    rcall Delay
	rjmp BUSCAR_BOTON

    ori LED, 0b10000000
    out PORTD, LED
	rcall Delay

SEC7_FIN:

    ; revisar botones
    sbis PINC, PC0
    rjmp SIGUIENTE

    sbis PINC, PC1
    rjmp ANTERIOR

    sbis PINC, PC2
    rjmp RESET_SEC

    rjmp SEC7_FIN

BUSCAR_BOTON:
    sbis PINC, PC0
    rjmp SIGUIENTE

    sbis PINC, PC1
    rjmp ANTERIOR

    sbis PINC, PC2
    rjmp RESET_SEC
	ret


;========================================================
; BOTÓN SIGUIENTE
; PC0
;========================================================

SIGUIENTE:

    inc SEQ

    cpi SEQ, 8
    brne SIG_FIN
    ldi SEQ, 1

SIG_FIN:
    ; esperar que se suelte el botón
ESPERA_PC0:
    sbis PINC, PC0
    rjmp ESPERA_PC0

    rjmp MAIN


;========================================================
; BOTÓN ANTERIOR
; PC1
;========================================================

ANTERIOR:

    dec SEQ

    cpi SEQ, 0
    brne ANT_FIN
    ldi SEQ, 7

ANT_FIN:

    ; esperar que se suelte el botón
ESPERA_PC1:
    sbis PINC, PC1
    rjmp ESPERA_PC1

    rjmp MAIN


;========================================================
; BOTÓN RESET
; PC2
;========================================================

RESET_SEC:

    ldi SEQ, 1

    ; apagar todos los LED
    ldi LED, 0
    out PORTD, LED

    ; esperar que se suelte
ESPERA_PC2:
    sbis PINC, PC2
    rjmp ESPERA_PC2

    rjmp MAIN


;========================================================
; DELAY
;
; Retardo de aproximadamente 1 segundo
;========================================================

Delay:
    ldi  r19, 234
    ldi  r20, 200
    ldi  r21, 199
L1: dec  r21
    breq L1
    dec  r20
    breq L1
    dec  r19
    breq L1
    ret 
