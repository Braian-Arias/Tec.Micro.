//Lavarropas 

.equ PORTB = 0x05
.equ DDRB  = 0x04
.equ PIND  = 0x09
.equ DDRD  = 0x0A
.equ PORTD = 0x0B

.org 0x0000
    rjmp INICIO

INICIO:
    ; PB0 y PB1 = motor
    ; PB2, PB3 y PB4 = LEDs
    ldi r16, 0b00011111
    out DDRB, r16

    ; PD2, PD3 y PD4 = botones
    ldi r16, 0
    out DDRD, r16

    ; Pull-up botones
    ldi r16, 0b00011100
    out PORTD, r16

PRINCIPAL:

    sbis PIND, 2
    rcall LAVADO

    sbis PIND, 3
    rcall CENTRIFUGADO

    sbis PIND, 4
    rcall SECADO

    rjmp PRINCIPAL


; -------------------------
; LAVADO
; ERROR: hace 3 ciclos
; debería hacer 5
; -------------------------

LAVADO:
    sbi PORTB, 2
    ldi r20, 3

LAV_LOOP:
    sbi PORTB, 0
    cbi PORTB, 1
    rcall DELAY

    cbi PORTB, 0
    rcall DELAY

    dec r20
    brne LAV_LOOP

    cbi PORTB, 2
    ret


; -------------------------
; CENTRIFUGADO
; ERROR: dura poco tiempo
; -------------------------

CENTRIFUGADO:
    sbi PORTB, 3
    sbi PORTB, 0
    cbi PORTB, 1

    rcall DELAY
    rcall DELAY

    cbi PORTB, 0
    cbi PORTB, 3
    ret


; -------------------------
; SECADO
; INCOMPLETO:
; falta giro izquierdo
; -------------------------

SECADO:
    sbi PORTB, 4

    sbi PORTB, 0
    cbi PORTB, 1
    rcall DELAY

    cbi PORTB, 0
    cbi PORTB, 4
    ret


; -------------------------
; RETARDO
; -------------------------

DELAY:
    ldi r18, 255

D1:
    ldi r19, 255

D2:
    dec r19
    brne D2
    dec r18
    brne D1

    ret
