.equ PORTB = 0x05
.equ DDRB  = 0x04

.equ PIND  = 0x09
.equ DDRD  = 0x0A
.equ PORTD = 0x0B


.cseg

.org 0x0000
    rjmp INICIO


INICIO:

    ; Configurar pila

    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ldi r16, LOW(RAMEND)
    out SPL, r16

    ;-------------------------------------------------------------
    ; PORTB
    ; PB0 motor
    ; PB1 motor
    ; PB2 LED lavado
    ; PB3 LED centrifugado
    ; PB4 LED secado
    ; PB5 LED listo
    ; -------------------------------------------------------------

    ldi r16, 0b00111111
    out DDRB, r16

    ldi r16, 0
    out PORTB, r16

    ;-------------------------------------------------------------
    ; PORTC
    ; PC0 LED fin
    ; PC1 carga ligera
    ; PC2 carga media
    ; PC3 carga pesada
    ; -----------------------------------------------------------

    ldi r16, 0b00001111
    out DDRC, r16

    ldi r16, 0
    out PORTC, r16


    ; -----------------------------------------------------------
    ; PORTD
    ; PD2 inicio
    ; PD3 seleccion carga
    ; PD4 puerta
    ; PD5 sensor agua
    ; ---------------------------------------------------------

    ldi r16, 0
    out DDRD, r16


    ; Pull-up PD2-PD5

    ldi r16, 0b00111100
    out PORTD, r16


    ; Carga inicial = ligera

    clr r21

    rcall MOSTRAR_CARGA


    ; Lavadora lista


CAMBIAR_CARGA:

    ldi r24, LOW(30)
    ldi r25, HIGH(30)
    rcall DELAY_MS

    ; Si ya se soltó, salir

    sbic PIND, 3
    ret


    ; Cambiar carga
    ; 0 ligera
    ; 1 media
    ; 2 pesada

    inc r21

    cpi r21, 3
    brlo CARGA_OK

    clr r21


CARGA_OK:

    rcall MOSTRAR_CARGA


ESPERAR_CARGA:

    sbis PIND, 3
    rjmp ESPERAR_CARGA


    ldi r24, LOW(30)

MOSTRAR_CARGA:

    ; Apagar los tres LEDs

    cbi PORTC, 1
    cbi PORTC, 2
    cbi PORTC, 3


    ; Carga ligera

    cpi r21, 0
    brne VER_MEDIA

    sbi PORTC, 1
    ret


VER_MEDIA:

    cpi r21, 1
    brne VER_PESADA

    sbi PORTC, 2
    ret


VER_PESADA:

    sbi PORTC, 3

    ret
    ldi r25, HIGH(30)
    rcall DELAY_MS

    ret

    sbi PORTB, 5


PRINCIPAL:

    ; PD3 = cambiar carga

    sbis PIND, 3
    rcall CAMBIAR_CARGA

    ; PD2 = iniciar ciclo

    sbis PIND, 2
    rcall INICIAR_CICLO

    rjmp PRINCIPAL

INICIAR_CICLO:

    ldi r24, LOW(30)
    ldi r25, HIGH(30)
    rcall DELAY_MS

    ; Confirmar que sigue presionado

    sbic PIND, 2
    ret

ESPERAR_INICIO:

    sbis PIND, 2
    rjmp ESPERAR_INICIO

VERIFICAR_PUERTA:

    ; Si PD4 = 0, la puerta esta cerrada

    sbic PIND, 4
    rjmp PUERTA_ABIERTA


    ; Puerta cerrada
    ; continuar

    rjmp ESPERAR_AGUA


PUERTA_ABIERTA:

    ; Volver al estado listo

    sbi PORTB, 5

    ret

    rcall LAVADO

    rcall CENTRIFUGADO

    rcall SECADO

    rcall FIN_PROCESO

    ret

;-------------------------------------------------------------------------------------------------------------
;Intrucciones que tiene que hacer para que parezca una verdadera lavadora automatica
;-------------------------------------------------------------------------------------------------------------

LAVADO:

    rcall APAGAR_LEDS_PROCESO

    ; LED lavado

    sbi PORTB, 2


    ; 5 ciclos

    ldi r20, 5


LAV_LOOP:

    rcall MOTOR_DERECHA


    cpi r21, 0
    breq LAV_GIRO_LIGERA

    cpi r21, 1
    breq LAV_GIRO_MEDIA

    rjmp LAV_GIRO_PESADA

CENTRIFUGADO:

    rcall APAGAR_LEDS_PROCESO

    sbi PORTB, 3

    rcall MOTOR_DERECHA

    cpi r21, 0
    breq CENT_LIGERA

    cpi r21, 1
    breq CENT_MEDIA

    rjmp CENT_PESADA

MOTOR_DERECHA:

    sbi PORTB, 0
    cbi PORTB, 1

    ret


MOTOR_IZQUIERDA:

    cbi PORTB, 0
    sbi PORTB, 1

    ret


MOTOR_PARAR:

    cbi PORTB, 0
    cbi PORTB, 1

    ret

APAGAR_LEDS_PROCESO:

    cbi PORTB, 2
    cbi PORTB, 3
    cbi PORTB, 4

    ret
